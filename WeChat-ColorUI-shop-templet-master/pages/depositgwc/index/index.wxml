<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title" style="font-weight: 550;display: flex;align-items: center;justify-content: center;position: relative;">
            <text bindtap="back" class="icon-back" style="width:40rpx;position: absolute;right: 280rpx;"></text>
            <text style="font-size:32rpx;font-weight:800;color:black;">确认销售单</text>
        </view>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl  shadow-lg" style="background-color:white;margin-top:-100rpx;">
    <view style="display: flex;width: 100%;font-size:30rpx;">
        <view style="width: 30%;margin:40rpx 0rpx 0rpx 40rpx;">
            <text>配送方式</text>
        </view>
        <view style="width: 70%;margin:10rpx 40rpx 0rpx 40rpx;">
            <view class="cu-form-group">
                <radio-group bindchange="radioChange1" class="radio-group">
                    <label class="radio ">
                        <radio checked class="round red" value="0"></radio>快递运输 </label>
                    <!-- <label class="radio">
                        <radio class="round red" value="1" disabled></radio>到店取货 </label> -->
                </radio-group>
            </view>
        </view>
    </view>
    <view wx:if="{{flag}}">
        <view wx:if="{{setype=='0'}}">
            <view style="display: flex;width: 100%;">
                <view style="width: 80%;margin:20rpx 0rpx 0rpx 40rpx;">
                    <text>{{address1}}</text>
                </view>
                <view hidden="{{tags}}" style="width:12%;height:60rpx;margin-top:20rpx;margin-right:60rpx; background-color: rgb(195, 167, 105); color: white;border-radius:20rpx;display: flex;align-items: center;justify-content: center;">默认</view>
            </view>
            <view bindtap="showModal" data-target="bottomModal" style="display: flex;width: 100%;">
                <view style="width: 70%;margin:20rpx 0rpx 0rpx 40rpx;font-weight: 700;font-size:32rpx;">
                    <text>{{address2}}</text>
                </view>
                <view style="width: 30%;display: flex; align-items:flex-end;justify-content:flex-end;align-self:flex-end; margin:40rpx 40rpx 0rpx 0rpx;color:gray;">
                    <text style="margin-top:-20rpx;font-size:28rpx;font-weight: 700;color:burlywood;">>>>更换地址</text>
                </view>
            </view>
            <view style="display: flex;width: 100%;">
                <view style="width: 20%;margin:20rpx 0rpx 0rpx 40rpx;">
                    <text>{{body}}</text>
                </view>
                <view style="width: 20%;margin:26rpx 0rpx 0rpx 0rpx;">
                    <text>{{phone}}</text>
                </view>
            </view>
            <view style="display: flex;width: 100%;">
                <view style="width: 20%;margin:40rpx 0rpx 0rpx 40rpx;">
                    <text>运费</text>
                </view>
                <view style="width: 20%;height:72rpx;margin:36rpx 0rpx 0rpx 0rpx; color: rgb(195, 167, 105);" wx:if="{{sumwlprice==0||!sumwlprice}}">
                    <text style="font-weight: 700;font-size:32rpx;">免运费</text>
                </view>
                <view style="width: 20%;height:72rpx;margin:44rpx 0rpx 0rpx 0rpx; color: rgb(195, 167, 105);" wx:else>
                    <text style="font-weight: 700;font-size:32rpx;">{{sumwlprice}}</text>
                    <text style="font-size:24rpx;font-weight: 700;color:rgb(195,167,105);">元</text>
                </view>
            </view>
        </view>
        <view wx:else>
            <view style="display: flex;width: 100%;">
                <view style="width: 70%;margin:20rpx 0rpx 0rpx 40rpx;">
                    <text>{{address1}}</text>
                </view>
                <view style="width:12%;height:60rpx;margin-top:20rpx;margin-right:60rpx; background-color: rgb(195, 167, 105); color: white;border-radius:20rpx;display: flex;align-items: center;justify-content: center;" wx:if="{{fg==1}}">默认</view>
            </view>
            <view style="display: flex;width: 100%; margin-bottom:10rpx;">
                <view style="width: 75%;margin:20rpx 0rpx 0rpx 40rpx;font-weight: 700;font-size:32rpx;">
                    <text>{{address2}}</text>
                </view>
            </view>
            <view style="display: flex;width: 100%; margin-bottom:40rpx;">
                <view style="width: 100%;margin:20rpx 0rpx 0rpx 40rpx;font-size:28rpx;">
                    <text>{{telphone}}</text>
                </view>
            </view>
        </view>
    </view>
    <view wx:else>
        <view style="display: flex;width: 100%;">
                <view style="width: 80%;margin:20rpx 0rpx 0rpx 40rpx;">
                    <text>暂未获取到收货地址</text>
                </view>
            </view>
        <view bindtap="add" style="display: flex;width: 100%;padding-bottom:40rpx;">
            <view style="width: 50%;margin:20rpx 0rpx 0rpx 40rpx;font-weight: 700;font-size:32rpx;">
                <text>请新建收货地址</text>
            </view>
            <view style="width: 50%;display: flex; align-items:flex-end;justify-content:flex-end;align-self:flex-end; margin:40rpx 40rpx 0rpx 40rpx;color:gray;">
                <text style="margin-top:-20rpx;font-size:24rpx;color:burlywood;">>>>新建地址</text>
            </view>
        </view>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl  shadow-lg">
    <view class="canui-order-item bg-white">
        <view class="head-title-box" style="margin:0rpx 0rpx 0rpx 40rpx;">
            <view style="height:20rpx;"></view>
            <text class="icon-shop"></text>
            <text style="margin-left:10rpx;">广天藏品</text>
        </view>
        <view catchtap="selectsku" data-XF_PLU="{{item.XF_PLU}}" wx:for="{{replu}}" wx:key="XF_PLU">
            <view class="Grid-sku" style="border-radius:16rpx;background-color:white;margin:10rpx 0rpx 10rpx 0rpx;">
                <view style="margin-left:20rpx;margin-top:30rpx;height:200rpx;width:200rpx;">
                    <image mode="widthFix" src="{{scimgurl}}{{item.XF_PLU}}/{{item.IMAGESSL}}" style="border-radius:10rpx;"></image>
                </view>
                <view style="margin-left:30rpx;width:70%;margin-top:20rpx;">
                    <view>
                        <text>{{item.XF_DESCI}}</text>
                    </view>
                    <view>
                        <text>编号：{{item.XF_PLU}}</text>
                    </view>
                    <block wx:if="{{item.XF_VIPPRICE}}">
                        <view style="color:red;margin:10rpx 0rpx 0rpx 150rpx;">会员实价</view>
                    </block>
                    <view style="color:red;margin:10rpx 0rpx 0rpx 150rpx;" wx:elif="{{item.XF_WZK}}">促销实价</view>
                    <block wx:elif="{{item.XF_ZKPRICE}}">
                        <view style="color:red;margin:10rpx 0rpx 0rpx 150rpx;">会员折扣价</view>
                    </block>
                    <view style="display: flex;width:100%;">
                        <view style="color:rgb(195,167,105);margin-top:16rpx;width:30%;">
                            <text class="text-price"></text>
                            <text style="font-weight: 700;margin-left:10rpx;{{item.XF_VIPPRICE||(!item.XF_WZK&&item.XF_ZKPRICE)?'text-decoration: line-through;':''}}">{{item.XF_ORGUPRICE}}</text>
                        </view>
                        <view style="color:rgb(195,167,105);margin-top:16rpx;width:30%;margin-left:24rpx;">
                            <block wx:if="{{item.XF_VIPPRICE}}">
                                <text class="text-price"></text>
                                <text style="font-weight: 700;margin-left:10rpx;">{{item.XF_VIPPRICE}}</text>
                            </block>
                            <block wx:elif="{{!item.XF_WZK&&item.XF_ZKPRICE}}">
                                <text class="text-price"></text>
                                <text style="font-weight: 700;margin-left:10rpx;">{{item.XF_ZKPRICE}}</text>
                            </block>
                        </view>
                        <view style="width: 70%;margin-top:4rpx;text-align: right;margin-right:16rpx;">
                            <view class="cu-btn" style="background-color:rgb(243, 244, 246);height:50rpx;width:10%;font-size:24rpx;">X</view>
                            <view class="cu-btn" style="background-color:rgb(243, 244, 246);height:50rpx;margin-left:6rpx;margin-top:10rpx;width:10%;">{{item.XF_QTY}}</view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="cu-list menu bg-white solid-bottom canui-selet">
            <view class="cu-item">
                <view class="content"> 共 <text class="text-red">{{sumqty}}</text> 件商品 </view>
                <view class="action"> 小计： <text class="text-price" style="font-size:36rpx;color:rgb(195,167,105);font-weight:800;">{{sumrealprice}}</text>
                </view>
            </view>
        </view>
        <view class="cu-form-group bg-white canui-input">
            <view>买家留言</view>
            <input bindinput="getremark" class="radius" name="remark" placeholder="" style="font-size:24rpx;margin:10rpx 0rpx 0rpx 20rpx;"></input>
        </view>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl  shadow-lg" style="height:160rpx;background-color:white;margin-top:20rpx;">
    <view style="margin-left:40rpx;">
        <image src="/img/basics.png" style="width:80rpx;height:80rpx;margin-top:40rpx;"></image>
    </view>
    <view style="margin-top:-80rpx;margin-left:160rpx;">
        <text class="text-black ">优惠券</text>
        <text class="icon-right" style="float: right;color:gray;margin-right:40rpx;margin-top:6rpx;"></text>
        <text style="float: right;color:gray;margin-right:10rpx;">暂无可用</text>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl  shadow-lg" style="height:160rpx;background-color:white;margin-top:20rpx;">
    <view bindtap="scj" class=" ">
        <view style="margin-left:40rpx;">
            <image src="/img/about.png" style="width:80rpx;height:80rpx;margin-top:40rpx;"></image>
        </view>
        <view style="margin-top:-80rpx;margin-left:160rpx;" wx:if="{{grade && grade != 'null'}}">
            <text class="text-black">会员卡</text>
            <text class="icon-right" style="float: right;color:gray;margin-right:40rpx;margin-top:6rpx;"></text>
            <text style="float: right;color: rgb(195, 167, 105);margin-top:-4rpx;font-weight:700;margin-right:10rpx;">{{grade}}</text>
        </view>
        <view style="margin-top:-80rpx;margin-left:160rpx;" wx:else>
            <text class="text-black">会员卡</text>
            <text class="icon-right" style="float: right;color:gray;margin-right:40rpx;margin-top:6rpx;"></text>
            <text style="float: right;margin-top:-4rpx;color:gray;font-weight:700;margin-right:10rpx;"></text>
        </view>
    </view>
</view>
<view style="height:400rpx;"></view>
<view hidden="{{flags}}">
    <view class="bg-white canui-foor-fixed canui-submit-view " style="height:320rpx;">
        <view style="display: flex;width: 100%;margin-top:40rpx;">
            <view style="width:15%;margin-left:40rpx;">明细>>></view>
            <view style="height:60rpx;width:60%;background-image:linear-gradient(45deg, #ff9700, #ed1c24); color: white;border-radius:20rpx;display: flex;align-items: center;justify-content: center;">
                <text>商品价格 ¥{{sumrealprice}} + 快递费 ¥{{sumwlprice}}</text>
            </view>
        </view>
        <view style="display: flex;width: 100%;">
            <view style="margin-left:40rpx;font-size:32rpx;margin-top:48rpx;width: 70%;">
                <text>应付：</text>
                <text class="text-price" style="font-size:36rpx;color:rgb(195,167,105);font-weight:700;">{{sumprice}}</text>
            </view>
            <view  style="width: 35%;margin-top:-10rpx;">
                <button bindtap="payment" disabled="{{stop}}" class="submitbtn" style="margin:40rpx 40rpx 40rpx 0rpx;">
                    <text> 立即购买</text>
                </button>
            </view>
        </view>
    </view>
</view>
<view class="cu-modal bottom-modal {{modalName=='bottomModal'?'show':''}}" style="background-color: white;">
    <view style="height:80rpx;background-color: white; border-radius:20rpx 20rpx 0rpx 0rpx;"></view>
    <view bindtap="hideModal" style="height:120rpx;background-color: white;font-size:32rpx;font-weight: 700;">
        <text>选择收货地址</text>
        <text class="icon-close" style="float: right;color:gray;margin-right:40rpx;"></text>
    </view>
    <checkbox-group>
        <view bindtap="checkboxChange" data-address1="{{item.ADDRESS1}}" data-address2="{{item.ADDRESS2}}" data-body="{{item.BODY}}" data-id="{{item.ID}}" data-phone="{{item.PHONE}}" data-tag="{{item.TAG}}" style="background-color: white;" wx:for="{{ret}}" wx:key="ID">
            <view style="display: flex;width: 100%;">
                <view style="width: 10%;margin-top:40rpx;margin-left:20rpx;" wx:if="{{item.ID==ck}}">
                    <checkbox checked class="checkbox" value="{{item.ID}}"></checkbox>
                </view>
                <view style="width: 10%;margin-top:40rpx;margin-left:20rpx;" wx:else>
                    <checkbox class="checkbox" value="{{item.ID}}"></checkbox>
                </view>
                <view style="width: 90%;text-align: left;">
                    <text class="text-black">
            {{item.ADDRESS1}}{{item.ADDRESS2}}</text>
                </view>
            </view>
            <view style="display: flex;width: 100%;color:gray;">
                <view style="width:20%;height:60rpx;margin-top:36rpx;margin-left:40rpx; background-color: rgb(195, 167, 105); color: white;border-radius:20rpx;align-items: center;justify-content: center;display: flex;" wx:if="{{item.TAG=='1'}}">默认</view>
                <view style="width:25%;margin-top:40rpx;margin-left:20rpx;color:gray;font-weight: 500;">
                    <text>{{item.BODY}}</text>
                </view>
                <view style="width:25%;margin-top:46rpx;color:gray;font-weight: 500;">
                    <text>{{item.PHONE}}</text>
                </view>
                <view catchtap="edit" data-id="{{item.ID}}" style="margin-top:40rpx;width:100%;display: flex;justify-content:flex-end;">
                    <text class="icon-writefill" style="color:gray;margin-right:80rpx;"></text>
                </view>
            </view>
            <view style="height:20rpx;background-color: white;"></view>
            <view style="width:90%;height:1rpx;background-color: rgb(243, 229, 229);margin:0 auto;justify-content: center;display: flex;"></view>
            <view style="height:20rpx;background-color:white;"></view>
        </view>
    </checkbox-group>
    <view bindtap="add" class="bg-white canui-submit-view " style="padding-bottom:120rpx;padding-top:40rpx;">
        <view style="width:80%;background-color: rgb(195, 167, 105); color: white;border-radius:20rpx;margin:0 auto;align-items: center;justify-content: center;margin-top:40rpx;display: flex;height:80rpx;">新增地址 </view>
    </view>
</view>
