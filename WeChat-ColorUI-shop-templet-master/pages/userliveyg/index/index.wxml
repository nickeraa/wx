<view class="cu-custom bg-white" style="height:100rpx;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title" style="font-weight: 550;">广天特邀</view>
    </view>
</view>



<view class="cu-bar bg-white" >
    <image mode="widthFix" src="{{iconurl}}logo.jpg"></image>
</view>


<view wx:if="{{state==1}}">

<!-- 容器 -->
<view class="live-container" style="margin-top: 10rpx;">

<!-- 封面 + 信息 -->
 <view class="live-cover">
  <swiper autoplay="true" circular="true" class="screen-swiper square-dot shadow-warp bg-white" duration="300" indicatorDots="true" interval="2000" style="height:{{swiperHeight}}rpx;width:100%;">
        <swiper-item wx:for="{{swiperList}}" wx:key="itemid">
            <image  mode="aspectFit" src="{{item.img}}" style="height:{{swiperHeight}}rpx;width:100%;" binderror="imgError" data-idx="{{index}}"></image>
        </swiper-item>
    </swiper>

  <view class="live-info">
    <text class="live-title">{{liveTitle}}</text>
  </view>
</view> 
</view>


    <view style="margin:60rpx auto 20rpx;width:90%;padding-bottom:96rpx;">
