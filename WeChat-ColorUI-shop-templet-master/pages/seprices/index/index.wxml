<view class="cu-custom">
    <view class="cu-bar fixed none-bg text-white bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <navigator class="action canui-head-title" hoverClass="none" openType="navigateBack">
            <text class="icon-back"></text>售价及库存查询 </navigator>
    </view>
</view>
<view style="overflow-x: hidden;">
    <view style="height:4rem;background-color:white;"></view>
    <view class=" margin-top">
        <view style="background-color:white;height:0.5rem;"></view>
        <view class="canui-order-item bg-white">
            <view class="head-title-box" style="height:2.2rem;">
                <text class="icon-shop" style="margin-left:1rem;"></text>
                <text calss="sp" style="margin-left:6rpx;">货品信息</text>
                <text class="icon-right">{{xf_desci}}</text>
                <view class="head-title-box sp solid-bottom "></view>
            </view>
            <view class="Grid-sku  " style="height:0.8rem;color:#00868B;margin-top:16rpx;">
                <view style="margin-left:1rem;width:25%;">
                    <text> 货品编号 </text>
                </view>
                <view style="width:20%;margin-left:40rpx;">
                    <text>售价</text>
                </view>
                <view style="width:20%;margin-left:40rpx;">
                    <text>总销售</text>
                </view>
                <view style="width:15%;">
                    <text>库存</text>
                </view>
                <view style="width:15%;">
                    <text>在途</text>
                </view>
                <view style="width:15%;">
                    <text>客订</text>
                </view>
                <view style="width:15%;">
                    <text>可售</text>
                </view>
            </view>
            <view style="background-color:white;height:10rpx;"></view>
            <view class="Grid-sku" style="background-color:white;height:2.5rem;margin-top:20rpx;font-size:28rpx;" wx:for="{{result}}" wx:key="id">
                <view style="margin-left:1rem;width:20%;margin-top:30rpx;">
                    <text class=""> {{item.XF_PLU}} </text>
                </view>
                <view style="width:22%;margin-left:30rpx;margin-top:24rpx;">
                    <text class=""> {{item.XF_SELUPRICE}}元 </text>
                </view>
                <view style="width:20%;margin-left:30rpx;margin-top:30rpx;">
                    <text class=""> {{item.XF_QTY}} </text>
                </view>
                <view style="width:15%;margin-top:30rpx;">
                    <text class=""> {{item.XF_QOH}} </text>
                </view>
                <view style="width:13%;margin-top:30rpx;">
                    <text class=""> {{item.XF_TRFINTRANSIT}} </text>
                </view>
                <view style="width:13%;margin-top:30rpx;">
                    <text class=""> {{item.XF_ORDERQTY}} </text>
                </view>
                <view style="width:15%;margin-top:30rpx;">
                    <text class=""> {{item.QTY}} </text>
                </view>
            </view>
        </view>
    </view>
    <view style="width:100%;margin:40rpx 0rpx 20rpx 20rpx;height:3rem;">
        <button bindtap="senumber" class="cu-btn round " style="margin:10rpx 10rpx 10rpx 10rpx;height:2.2rem;border-radius: 0.8rem;background-color: white;border:2rpx solid red;width:90%">查询货品明细</button>
    </view>
    <view style="background-color:white;height:10rpx;"></view>
    <view class="Grid-sku  " hidden="{{view}}" style="height:1.5rem;color:#00868B;">
        <view style="margin-left:1rem;width:15%;">
            <text> 店号 </text>
        </view>
        <view style="width:25%;margin-left:50rpx;">
            <text>店铺名称</text>
        </view>
        <view style="width:15%;">
            <text>库存</text>
        </view>
        <view style="width:15%;">
            <text>在途</text>
        </view>
        <view style="width:15%;">
            <text>客订</text>
        </view>
        <view style="width:15%;">
            <text>可售</text>
        </view>
    </view>
    <view hidden="{{view}}">
        <view class="Grid-sku" style="background-color:white;height:2.5rem;margin-top:10rpx;font-size:28rpx;" wx:for="{{results}}" wx:key="id">
            <view style="background-color:white;height:10rpx;"></view>
            <view style="margin-left:1rem;width:20%;margin-top:20rpx;">
                <text class=""> {{item.XF_STORECODE}} </text>
            </view>
            <view style="width:28%;margin-left:24rpx;margin-top:20rpx;">
                <text class=""> {{item.XF_NAME}}</text>
            </view>
            <view style="width:15%;margin-top:20rpx;">
                <text class=""> {{item.XF_QOH}} </text>
            </view>
            <view style="width:15%;margin-top:20rpx;">
                <text class=""> {{item.XF_TRFINTRANSIT}} </text>
            </view>
            <view style="width:15%;margin-top:20rpx;">
                <text class=""> {{item.XF_ORDERQTY}} </text>
            </view>
            <view style="width:15%;margin-top:20rpx;">
                <text class=""> {{item.QTY}} </text>
            </view>
        </view>
    </view>
</view>
