<view class="cu-custom bg-white" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title">
            <text bindtap="back" class="icon-back" style="width: 40rpx;margin-left: -9rem;"></text>
            <text style="font-size: 32rpx;font-weight: 800;color:black;margin-left: 7rem;">选择取货店铺</text>
        </view>
    </view>
</view>
<checkbox-group>
    <view bindtap="checkboxChange" data-address1="{{item.ADDRESS1}}" data-address2="{{item.ADDRESS2}}" data-checked="{{item.CHECKED}}" data-id="{{item.ID}}" data-telphone="{{item.TELPHONE}}" data-xf_storecode="{{item.XF_STORECODE}}" style="background-color: white;" wx:for="{{replu}}" wx:key="index">
        <view style="display: flex;width: 100%;">
            <view style="width: 10%;margin-top: 40rpx;margin-left: 40rpx;" wx:if="{{item.ID==dpid}}">
                <checkbox checked="true" class="checkbox" value="{{item.ID}}"></checkbox>
            </view>
            <view style="width: 10%;margin-top: 40rpx;margin-left: 40rpx;" wx:else>
                <checkbox class="checkbox" value="{{item.ID}}"></checkbox>
            </view>
            <view style="width: 60%;text-align: left;font-size: 32rpx;font-weight: 700;color: rgb(4, 61, 113);">
                <text>
          {{item.ADDRESS1}} </text>
            </view>
        </view>
        <view style="display: flex;width: 100%;color: gray;margin-left: 100rpx;font-weight: 500;">
            <text>
        {{item.ADDRESS2}} </text>
        </view>
        <view style="display: flex;width: 100%;">
            <view style="width:20%;height:1.5rem;margin-top: 36rpx;margin-left: 40rpx; background-color: rgb(195, 167, 105); color: white;border-radius: 20rpx;align-items: center;justify-content: center;display: flex;" wx:if="{{item.XF_STORECODE==item.CHECKED}}">默认</view>
            <view style="width:80%;margin-top: 46rpx;color:gray;font-weight: 500;margin-left: 100rpx;">
                <text>{{item.TELPHONE}}</text>
            </view>
        </view>
        <view style="height: 20rpx;background-color: white;"></view>
        <view style="width:90%;height: 1rpx;background-color: rgb(243, 229, 229);justify-content: center;display: flex;"></view>
        <view style="height: 20rpx;background-color:white;"></view>
    </view>
</checkbox-group>
<view style="height: 5rem;"></view>
