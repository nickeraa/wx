                <image bindtap="previewZwImage" data-src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES6}}" class="imgs" mode="widthFix" src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES6}}" style="width:650rpx"></image>
            </view>
            <view style="margin:40rpx;" wx:if="{{item.ZWIMAGES7}}">
                <image bindtap="previewZwImage" data-src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES7}}" class="imgs" mode="widthFix" src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES7}}" style="width:650rpx"></image>
            </view>
            <view style="margin:40rpx;" wx:if="{{item.ZWIMAGES8}}">
                <image bindtap="previewZwImage" data-src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES8}}" class="imgs" mode="widthFix" src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES8}}" style="width:650rpx"></image>
            </view>
            <view style="margin:40rpx;" wx:if="{{item.ZWIMAGES9}}">
                <image bindtap="previewZwImage" data-src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES9}}" class="imgs" mode="widthFix" src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES9}}" style="width:650rpx"></image>
            </view>
            <view style="margin:40rpx;padding-bottom: 80rpx;" wx:if="{{item.ZWIMAGES10}}">
                <image bindtap="previewZwImage" data-src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES10}}" class="imgs" mode="widthFix" src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES10}}" style="width:650rpx"></image>
            </view>
        </view>
        <view style="background-color: white;height: 260rpx;"></view>
    </view>
    <view class="btns" style="height: 256rpx; display: flex; box-sizing: border-box; left: 0rpx; top: 1368rpx">
        <view class="cu-list  grid col-{{gridCol}} {{gridBorder?'':'no-border'}} btn-icons" style="height: 124rpx; display: flex; box-sizing: border-box">
            <view class="cu-item" wx:for="{{iconList}}" wx:key="icon" style="position: relative; left: 1rpx; top: -25rpx">
                <block wx:if="{{index == 1 && !vipcode && !wxuserid}}">
                    <button openType="getPhoneNumber" bindgetphonenumber="onGetPhoneNumbersc" class="icon-favor-btn icon-{{item.icon}} text-{{item.color}}" style="font-size: 32rpx; position: relative; left: 0rpx; top: -46rpx">
                        <text style="font-size: 24rpx;color:{{item.color}}">{{item.name}}</text>
                    </button>
                </block>
                <block wx:else>
                    <view catchtap="setype" class="icon-{{item.icon}} text-{{item.color}}" data-name="{{item.name}}" style="font-size: 32rpx; position: relative; left: 0rpx; top: -46rpx">
                        <text style="font-size: 24rpx;color:{{item.color}}">{{item.name}}</text>
                    </view>
                </block>
            </view>
        </view>
        <view class="view_qipao" wx:if="{{n>0}}">
            <text class="text_qipao">{{n}}</text>
        </view>
        <view class="btn-actions" wx:if="{{vipcode||wxuserid}}">
            <button bindtap="gw" class="submitbtns" style="position: relative; left: -44rpx; top: -40rpx">
                <text> 点击关注 </text>
            </button>
            <button bindtap="gwjs" disabled="{{stop}}" class="submitbtn" style="position: relative; left: -43rpx; top: -40rpx">
                <text> 立即购买</text>
            </button>
        </view>
        <view class="btn-actions" wx:else>
            <button bindgetphonenumber="onGetPhoneNumbergwc" class="submitbtns" openType="getPhoneNumber" style="position: relative; left: -22rpx; top: -39rpx">
                <text> 点击关注 </text>
            </button>
            <button bindgetphonenumber="onGetPhoneNumbergm" disabled="{{stop}}" class="submitbtn" openType="getPhoneNumber" style="position: relative; left: -22rpx; top: -40rpx">
                <text> 立即购买 </text>
            </button>
        </view>
    </view>