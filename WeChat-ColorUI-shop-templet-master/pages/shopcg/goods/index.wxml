            </view>
            <view style="margin:40rpx;" wx:if="{{item.ZWIMAGES3}}">
                <image bindtap="previewZwImage" data-src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES3}}" class="imgs" mode="widthFix" src="{{pict}}{{item.XF_PLU}}//{{item.ZWIMAGES3}}" style="width:650rpx"></image>
            </view>
