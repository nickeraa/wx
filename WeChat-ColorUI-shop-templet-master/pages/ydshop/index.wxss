page {
  padding-bottom: 20rpx;
  padding-top: 50px;
}
.head-title {
  margin: 0 auto;
}
.cu-custom .cu-bar {
  background-color: #fff;
  padding-right: inherit;
}
.line-green,
.lines-green,
.text-green {
  color: #e45c5c;
}
.swiperitem {
  background: #fff;
  height: 55px;
}
.canui-video {
  height: 425rpx;
  width: 100%;
}
.nav-li,
.nav-list {
  padding: 0;
  z-index: 0;
}
.canui-yx-url {
  margin: 0 2% 30rpx !important;
  width: 46% !important;
}
.canui-flex-car {
  padding-top: 10px;
}
.canui-flex-car .cu-card > .cu-item {
  margin: 0;
  position: relative;
}
.canui-flex-car .cu-list.menu-avatar > .cu-item {
  height: 180rpx;
  padding-left: 15rpx;
}
.canui-flex-car .cu-card .cu-avatar {
  bottom: 72rpx;
  position: absolute;
  right: 10px;
}
.canui-flex-car .shadow-warp {
  box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.1);
}
.canui-flex-car .cu-list.menu > .cu-item .content {
  font-size: 26rpx;
}
.canui-flex-car .text-sm {
  font-size: 20rpx;
}
.canui-flex-car .text-grey {
  color: #000;
}
.canui-flex-car image {
  height: 173px !important;
}
.canui-gps .justify-between {
  padding: 0 10px;
}
.content .text-sm {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100px;
}
.canui-fixed {
  bottom: 0;
  position: fixed;
  width: 100%;
  z-index: 999999;
}
.tt {
  margin: 0 0 50px;
}
.pt {
  margin: 0 0 15px px;
}
.is_checked {
  background-color: #c3a769;
  border-radius: 5000rpx;
  color: #fff;
}
.Grid-sku {
  display: -webkit-flex;
  display: flex;
  width: 100%;
}
checkbox .wx-checkbox-input {
  border-radius: 50%;
  height: 35rpx;
  line-height: 35rpx;
  width: 35rpx;
}
checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background-color: #c3a769 !important;
  border: 1rpx solid #c3a769 !important;
  height: 35rpx;
  line-height: 35rpx;
  width: 35rpx;
}
.btns {
  background-color: #fff;
  bottom: 0;
  display: -webkit-flex;
  display: flex;
  align-items: center;
  height: 120rpx;
  justify-content: space-between;
  position: fixed;
  width: 100%;
  z-index: 1;
  box-sizing: border-box;
}
.btn-icons {
  flex: 0 0 45%;
  margin-top: 0 !important;
  padding-left: 20rpx;
}
.btn-icons .cu-item {
  margin-top: 0 !important;
  display: -webkit-flex !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}
.btn-icons .cu-item text {
  white-space: nowrap;
}
.btn-actions {
  flex: 0 0 55%;
  margin-top: 0 !important;
  display: -webkit-flex;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.submitbtn {
  background-color: #c3a769;
  border: none;
  border-radius: 0 70rpx 70rpx 0;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  display: -webkit-inline-flex;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
}
.submitbtns {
  background-color: #f3eee1;
  border: none;
  border-radius: 70rpx 0 0 70rpx;
  color: #c3a769;
  font-size: 30rpx;
  font-weight: 700;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  display: -webkit-inline-flex;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
}
.icon-favor-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  display: -webkit-inline-flex;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.icon-favor-btn::after {
  border: none;
}
.normal {
  background: #fff;
  color: grey;
}
.check,
.normal {
  align-items: center;
  box-sizing: border-box;
  display: -webkit-inline-flex;
  display: inline-flex;
  font-size: 28rpx;
  height: 64rpx;
  justify-content: center;
  line-height: 1;
  padding: 0 30rpx;
  position: relative;
}
.check {
  background: #c3a769;
  color: #fff;
}
.del {
  margin-top: 40px;
  position: absolute;
  z-index: 1;
}
.gp {
  margin-left: 20px;
}
.bgpp {
  color: red;
  font-size: 26rpx;
}
.bgcolor {
  height: 100%;
}
.bgcolor,
.cp {
  background: #fff;
}
.cp {
  height: 88px;
}
.up {
  text-transform: Uppercase;
}
.previewimg {
  height: 100%;
  width: 100%;
}
.imgs {
  height: auto;
  display: -webkit-flex;
  display: flex;
  width: 100%;
}
.resetbtn {
  background-color: #c3a769;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 30px;
  width: 50% !important;
}
.imageCount {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 40rpx;
  color: #fff;
  float: right;
  font-size: 26rpx;
  height: 50rpx;
  line-height: 50rpx;
  margin: -30px 0 0 300px;
  position: absolute;
  text-align: center;
  width: 120rpx;
  z-index: 1;
}
.video_cover {
  height: 100%;
  position: relative;
  width: 100%;
}
.video_play_icon {
  height: 40px;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 40px;
  z-index: 5;
}
.video_bg_black {
  background: rgba(0, 0, 0, 0.5);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}
.video_cover_txt {
  align-items: center;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  height: 90rpx;
  justify-content: flex-end;
  margin-top: 35rpx;
  text-align: right;
}
.video_icon_lock {
  height: auto;
  margin: 0 30rpx;
  width: 30rpx;
}
.video_txt {
  margin: 10px 70px 0 20px;
}
.view_qipao {
  position: absolute;
  left: 34%;
  top: 16rpx;
  align-items: center;
  background-color: red;
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  height: 35rpx;
  justify-content: center;
  margin: 0;
  width: 35rpx;
}
.text_qipao {
  color: #fff;
  font-size: 25rpx;
}
