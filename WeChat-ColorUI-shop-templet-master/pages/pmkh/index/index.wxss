page {
	padding-bottom: 20rpx;
	padding-top: 100rpx;
  }
  .head-title {
	margin: 0 auto;
  }
  .cu-custom .cu-bar {
	background-color: #fff;
	padding-right: inherit;
  }
  .line-green,
  .lines-green,
  .text-green {
	color: #e45c5c;
  }
  .swiperitem {
	background: #fff;
	height: 110rpx;
  }
  .canui-video {
	height: 425rpx;
	width: 100%;
  }
  .nav-li,
  .nav-list {
	padding: 0;
	z-index: 0;
  }
  .canui-yx-url {
	margin: 0 2% 30rpx !important;
	width: 46% !important;
  }
  .canui-flex-car {
	padding-top: 20rpx;
  }
  .canui-flex-car .cu-card > .cu-item {
	margin: 0;
	position: relative;
  }
  .canui-flex-car .cu-list.menu-avatar > .cu-item {
	height: 180rpx;
	padding-left: 15rpx;
  }
  .canui-flex-car .cu-card .cu-avatar {
	bottom: 72rpx;
	position: absolute;
	right: 20rpx;
  }
  .canui-flex-car .shadow-warp {
	box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.1);
  }
  .canui-flex-car .cu-list.menu > .cu-item .content {
	font-size: 26rpx;
  }
  .canui-flex-car .text-sm {
	font-size: 20rpx;
  }
  .canui-flex-car .text-grey {
	color: #000;
  }
  .canui-flex-car image {
	height: 346rpx !important;
  }
  .canui-gps .justify-between {
	padding: 0 20rpx;
  }
  .content .text-sm {
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 1;
	display: -webkit-box;
	overflow: hidden;
	text-overflow: ellipsis;
	width: 200rpx;
  }
  .canui-fixed {
	bottom: 0;
	position: fixed;
	width: 100%;
	z-index: 999999;
  }
  .tt {
	margin: 0 0 100rpx;
  }
  .pt {
	margin: 0 0 30rpx;
  }
  .is_checked {
	background-color: #c3a769;
	border-radius: 5000rpx;
	color: #fff;
  }
  .normal {
	background: #fff;
  }
  .textuser {
	font-size: 30rpx;
	font-weight: 800;
	height: 50rpx;
	line-height: 50rpx;
	margin: -290rpx 0 0 240rpx;
	position: absolute;
	width: 300rpx;
	z-index: 1;
  }
  .bgvip {
	background-image: linear-gradient(45deg, #422b07, #0f0e0f);
	border-radius: 16rpx;
	margin-top: -100rpx;
	width: 95%;
  }
  .bgtx,
  .bgvip {
	align-items: center;
	display: -webkit-flex;
	display: flex;
	height: 3rem;
	position: absolute;
	z-index: 1;
  }
  .bgtx {
	margin-top: -320rpx;
	width: 35%;
  }
  button::after {
	border: none;
  }
  .view_qipao {
	align-items: center;
	background-color: red;
	border-radius: 50%;
	display: -webkit-flex;
	display: flex;
	height: 35rpx;
	justify-content: center;
	width: 35rpx;
  }
  .text_qipao {
	color: #fff;
	font-size: 25rpx;
  }
  
  .avatar-wrapper {
	padding: 0;
	width: 112rpx !important;
	border-radius: 16rpx;
	margin-top: 80rpx;
	margin-bottom: 20rpx;
  }
  
  .avatar {
	display: block;
	width: 112rpx;
	height: 112rpx;
  }
  
  
  .del {
	margin: -50rpx 0 0 300rpx;
	position: absolute;
	z-index: 1;
  }
  .imgs {
	height: auto;
	display: -webkit-flex;
	display: flex;
	width: 100%;
  }
  .btns {
	background-color: #fff;
	bottom: 0;
	display: -webkit-flex;
	display: flex;
	align-items: center;
	height: 120rpx;
	justify-content: space-between;
	position: fixed;
	width: 100%;
	z-index: 1;
	box-sizing: border-box;
  }
  .btn-icons {
	flex: 0 0 45%;
	margin-top: 0 !important;
	padding-left: 20rpx;
  }
  .btn-icons .cu-item {
	margin-top: 0 !important;
	display: -webkit-flex !important;
	display: flex !important;
	align-items: center;
	justify-content: center;
  }
  .btn-icons .cu-item text {
	white-space: nowrap;
  }
  .btn-actions {
	margin-top: 0 !important;
	display: -webkit-flex;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: calc(100vh - 100rpx - 20rpx);
  }
  .submitbtn {
	background-color: #c3a769;
	border: none;
	border-radius: 70rpx;
	color: #fff;
	font-size: 40rpx;
	font-weight: 700;
	margin: 0 auto;
	height: 110rpx;
	line-height: 110rpx;
	display: -webkit-inline-flex;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0 80rpx;
  }
  .submitbtns {
	background-color: #f3eee1;
	border: none;
	border-radius: 70rpx 0 0 70rpx;
	color: #c3a769;
	font-size: 30rpx;
	font-weight: 700;
	margin: 0;
	height: 80rpx;
	line-height: 80rpx;
	display: -webkit-inline-flex;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0 36rpx;
  }
  .imageCount {
	background-color: rgba(0, 0, 0, 0.3);
	border-radius: 40rpx;
	color: #fff;
	float: right;
	font-size: 26rpx;
	height: 50rpx;
	line-height: 50rpx;
	margin: -30rpx 0 0 300rpx;
	position: absolute;
	text-align: center;
	width: 120rpx;
	z-index: 1;
  }
  .video_cover {
	height: 100%;
	position: relative;
	width: 100%;
  }
  .video_play_icon {
	height: 80rpx;
	left: 50%;
	position: absolute;
	top: 50%;
	transform: translate(-50%, -50%);
	width: 80rpx;
	z-index: 5;
  }
  .video_bg_black {
	background: rgba(0, 0, 0, 0.5);
	bottom: 0;
	left: 0;
	position: absolute;
	right: 0;
	top: 0;
  }
  .video_cover_txt {
	align-items: center;
	color: #fff;
	display: -webkit-flex;
	display: flex;
	font-size: 28rpx;
	height: 90rpx;
	justify-content: flex-end;
	margin-top: 35rpx;
	text-align: right;
  }
  .video_txt {
	margin: 20rpx 140rpx 0 40rpx;
  }
  .view_qipao {
	align-items: center;
	background-color: red;
	border-radius: 50%;
	display: -webkit-flex;
	display: flex;
	height: 35rpx;
	justify-content: center;
	width: 35rpx;
  }
  .text_qipao {
	color: #fff;
	font-size: 25rpx;
  }
  .icon-favor-btn {
	padding: 0;
	margin: 0;
	background: transparent;
	border: none;
	line-height: inherit;
	display: -webkit-inline-flex;
	display: inline-flex;
	align-items: center;
	justify-content: center;
  }
  .icon-favor-btn::after {
	border: none;
  }
  .view_qipao {
	position: absolute;
	left: 34%;
	top: 16rpx;
	margin: 0;
  }
  