<view class="cu-custom bg-white user-top-bar">
    <view class="cu-bar fixed none-bg bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title" style="font-weight: 550;">会员中心</view>
    </view>
</view>
<view>
    <image mode="widthFix" src="{{iconurl}}bg.png" class="user-banner"></image>
</view>
<view class="user-vip-wrap">
    <view class="bgvip">
        <text class="vip-label">广天藏品</text>
        <text class="vip-grade">{{vip}}</text>
        <text class="icon-right vip-arrow"></text>
    </view>
</view>
<view class="bgtx">
    <image src="{{tximg}}" class="user-avatar-img"></image>
</view>

<view class="bgtx get-card-wrap" hidden="{{flag}}">
    <button wx:if="{{canClaim}}" bindgetphonenumber="onGetPhoneNumber" class="submitbtn icon-goodsfavor get-card-btn" openType="getPhoneNumber">
        <text class="get-card-text">领取会员卡</text>
    </button>
    <button wx:else bindtap="onClaimBlocked" class="submitbtn icon-goodsfavor get-card-btn">
        <text class="get-card-text">领取会员卡</text>
    </button>
</view>

<view class="bgtx vip-info-wrap" hidden="{{flags}}">
    <view class="vip-no-block">
        <text class="vip-no-label">NO</text>
        <text class="vip-no-code">.{{vipcode}}</text>
    </view>
    <view class="vip-avatar-row" wx:if="{{flag && nickName}}">
      <image wx:if="{{avatarUrl}}" class="avatar avatar-wrapper" src="{{avatarUrl}}"></image>
      <view class="vip-nick-badge">
        <text class="vip-nick-text">{{nickName}}</text>
      </view>
    </view>
</view>
