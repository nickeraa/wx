<view class="cu-list menu card-menu margin-top-xl shadow-lg menu-card" style="margin-top:70rpx;">
    <view bindtap="qh">
        <view class="menu-img-wrap">
            <image src="/img/component.png" class="menu-img"></image>
        </view>
        <view class="menu-content">
            <text class="text-black">我的购物车</text>
            <text class="icon-right menu-arrow"></text>
        </view>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl shadow-lg menu-card">
    <view bindtap="mydj">
        <view class="menu-img-wrap">
            <image src="/img/my.png" class="menu-img"></image>
        </view>
        <view class="menu-content">
            <text class="text-black">我的预定单</text>
            <text class="icon-right menu-arrow"></text>
        </view>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl shadow-lg menu-card">
    <view bindtap="scj">
        <view class="menu-img-wrap">
            <image src="/img/home.png" class="menu-img-sm"></image>
        </view>
        <view class="menu-content-sm">
            <text class="text-black">我的收藏</text>
            <text class="icon-right menu-arrow"></text>
        </view>
    </view>
</view>
<view bindtap="address" class="cu-list menu card-menu margin-top-xl shadow-lg menu-card">
    <image src="/img/basics.png" class="menu-img-addr"></image>
    <button class="menu-btn-addr">
        <text class="text-black">收货地址</text>
    </button>
    <view class="menu-arrow-row">
        <text class="icon-right menu-arrow"></text>
    </view>
</view>
