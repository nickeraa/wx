page {
  background-color: #fff;
}
.head-title {
  margin: 0 auto;
}
.cu-custom .cu-bar {
  padding-right: inherit;
}

/* ===== 页面主体 ===== */
.page-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 0;
}

/* ===== 头像区 ===== */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}
.avatar-btn {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  display: block;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.avatar-placeholder {
  background-color: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-placeholder .icon-people {
  font-size: 88rpx;
  color: #c8c9cc;
}
.avatar-badge {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #c3a769;
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.badge-icon {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}
.avatar-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #969799;
}

/* ===== 昵称输入 ===== */
.input-section {
  width: 100%;
  margin-bottom: 96rpx;
}
.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}
.nickname-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}
.input-ph {
  color: #c8c9cc;
  font-size: 30rpx;
}

/* ===== 确认按钮 ===== */
.confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background-color: #c3a769;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(195, 167, 105, 0.35);
}
.confirm-btn::after {
  border: none;
}

/* ===== 隐私提示 ===== */
.privacy-tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #c8c9cc;
}
