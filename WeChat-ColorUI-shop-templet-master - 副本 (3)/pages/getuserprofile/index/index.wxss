page {
  background-color: #f5f5f5;
  padding-bottom: 170rpx;
}

.head-title { margin: 0 auto; }
.cu-custom .cu-bar { padding-right: inherit; }

.page-container { padding: 40rpx 30rpx; }

/* 头像 */
.avatar-section {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 0; background-color: #fff; border-radius: 16rpx;
  margin-bottom: 30rpx; box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.06);
}
.avatar-box {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  overflow: hidden; border: 4rpx solid #e8e8e8; margin-bottom: 30rpx;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-placeholder {
  display: flex; align-items: center; justify-content: center; background-color: #f5f5f5;
}
.choose-avatar-btn {
  font-size: 28rpx; color: #436EEE; background-color: #fff;
  border: 2rpx solid #436EEE; border-radius: 40rpx; padding: 16rpx 50rpx; line-height: 1.2;
}
.choose-avatar-btn::after { border: none; }

/* 昵称 */
.nickname-section {
  background-color: #fff; border-radius: 16rpx; padding: 30rpx;
  margin-bottom: 60rpx; box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.06);
}
.section-label { font-size: 28rpx; color: #999; margin-bottom: 20rpx; }
.nickname-input-wrap {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 2rpx solid #eee; position: relative;
}
.nickname-text { font-size: 32rpx; color: #333; font-weight: 500; }
.nickname-placeholder { font-size: 30rpx; color: #bbb; }
.nick-arrow { color: #ccc; font-size: 28rpx; }
.nickname-hidden-input {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  opacity: 0; z-index: 10;
}

/* 提交 */
.submit-section { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; }
.submit-btn {
  width: 600rpx; height: 88rpx; border-radius: 44rpx;
  font-size: 32rpx; font-weight: 600; letter-spacing: 2rpx; margin-bottom: 30rpx;
}
.submit-btn::after { border: none; }
.tip-text { font-size: 24rpx; color: #bbb; text-align: center; }
.canui-color-gradual { background-image: linear-gradient(45deg, #436EEE, #6B8AFF); color: #fff; }
