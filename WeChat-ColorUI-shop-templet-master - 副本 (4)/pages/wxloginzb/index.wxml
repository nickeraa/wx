<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;background-color:#fff;">
        <view class="head-title canui-head-title" style="font-weight:550;">
            <text bindtap="back" class="icon-back" style="width:40rpx;margin-left:-288rpx;color:#333;"></text>
            <text style="font-size:32rpx;font-weight:600;color:#1a1a1a;margin-left:224rpx;">头像昵称</text>
        </view>
    </view>
</view>

<view class="page-body">
    <!-- 头像选择 -->
    <view class="avatar-section">
        <button open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" class="avatar-btn">
            <image wx:if="{{avatarUrl}}" class="avatar-img" mode="aspectFill" src="{{avatarUrl}}"></image>
            <view wx:else class="avatar-img avatar-placeholder">
                <text class="icon-people"></text>
            </view>
            <view class="avatar-badge">
                <text class="badge-icon">+</text>
            </view>
        </button>
        <text class="avatar-tip">请点击选择微信头像</text>
    </view>

    <!-- 昵称输入 -->
    <view class="input-section">
        <text class="input-label">昵称</text>
        <input bindinput="bindKeyInput" class="nickname-input" placeholder="请选择微信昵称" placeholder-class="input-ph" type="nickname" value="{{nickName}}" />
    </view>

    <!-- 确认按钮 -->
    <button bindtap="lq" class="confirm-btn">登录直播间</button>

    <text class="privacy-tip">头像和昵称仅用于直播间显示</text>
</view>
