<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg text-white bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <navigator class="action canui-head-title">
            <text style="margin-left: 300rpx;">头像昵称</text>
        </navigator>
    </view>
</view>
<view class="b1" style="margin-top:3rem;">
    <view class="t_w">
        <view class="t_image" style='margin-top: 120rpx;'>
 
    <image class="avatar avatar-wrapper" src="{{avatarUrl}}"></image>
    <view style="width:100%;margin:-140rpx 0rpx 20rpx 20rpx;">
                <button open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" class="cu-btn round" style="margin: 0rpx 10rpx 10rpx 190rpx; height: 2.5rem; border-radius: 0.8rem;font-weight: 500; background-color: white; border: 2rpx solid #436EEE; width: 60%; position: relative; left: -10rpx; top: -31rpx">点击选择头像</button>
            </view>
    <input bindinput="bindKeyInput"  type="nickname" value='{{nickName}}' style='color: grey;margin-top: 60rpx;' placeholder="请选择自己的昵称"/>

        </view>
        <view class="b2" style="width: 600rpx; height: 529rpx; display: block; box-sizing: border-box;">
     
            <view style="width:100%;margin:430rpx 0rpx 20rpx 200rpx;">
                <button bindtap="lq" class="cu-btn canui-color-gradual shadow-blur" >领取会员卡</button>
                <button bindtap="back" class="cu-btn canui-color-blue shadow-blur" style='margin-left: 15rpx;'>返回</button>
            </view>
        </view>
    </view>
</view>
