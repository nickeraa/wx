page {
  padding-bottom: 20rpx;
  padding-top: 100rpx;
}
.head-title {
  margin: 0 auto;
}
.cu-custom .cu-bar {
  background-color: #fff;
  padding-right: inherit;
}
.name {
  font-size: 50rpx;
  
  background:  linear-gradient(45deg,#ff9700,#ed1c24);
  -webkit-background-clip: text;
  background-clip: text; /* 以文字的范围对背景进行裁剪 */
  color: transparent;
}
.line-green,
.lines-green,
.text-green {
  color: #e45c5c;
}
.swiperitem {
  background: #fff;
  height: 110rpx;
}
.canui-video {
  height: 425rpx;
  width: 100%;
}
.nav-li,
.nav-list {
  padding: 0;
  z-index: 0;
}
.canui-yx-url {
  margin: 0 2% 30rpx !important;
  width: 46% !important;
}
.canui-flex-car {
  padding-top: 20rpx;
}
.canui-flex-car .cu-card > .cu-item {
  margin: 0;
  position: relative;
}
.canui-flex-car .cu-list.menu-avatar > .cu-item {
  height: 180rpx;
  padding-left: 15rpx;
}
.canui-flex-car .cu-card .cu-avatar {
  bottom: 72rpx;
  position: absolute;
  right: 20rpx;
}
.canui-flex-car .shadow-warp {
  box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.1);
}
.canui-flex-car .cu-list.menu > .cu-item .content {
  font-size: 26rpx;
}
.canui-flex-car .text-sm {
  font-size: 20rpx;
}
.canui-flex-car .text-grey {
  color: #000;
}
.canui-flex-car image {
  height: 346rpx !important;
}
.canui-gps .justify-between {
  padding: 0 20rpx;
}
.content .text-sm {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 200rpx;
}
.canui-fixed {
  bottom: 0;
  position: fixed;
  width: 100%;
  z-index: 999999;
}
.tt {
  margin: 0 0 100rpx;
}
.pt {
  margin: 0 0 30rpx;
}
.is_checked {
  background-color: #c3a769;
  border-radius: 5000rpx;
  color: #fff;
}
.normal {
  background: #fff;
}
.textuser {
  font-size: 30rpx;
  font-weight: 800;
  height: 50rpx;
  line-height: 50rpx;
  margin: -290rpx 0 0 240rpx;
  position: absolute;
  width: 300rpx;
  z-index: 1;
}
.bgvip {
  background-image: linear-gradient(45deg, #422b07, #0f0e0f);
  border-radius: 16rpx;
  margin-top: -100rpx;
  width: 95%;
}
.bgtx,
.bgvip {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: 3rem;
  position: absolute;
  z-index: 1;
}
.bgtx {
  margin-top: -320rpx;
  width: 35%;
}
button::after {
  border: none;
}
.view_qipao {
  align-items: center;
  background-color: red;
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  height: 35rpx;
  justify-content: center;
  width: 35rpx;
}
.text_qipao {
  color: #fff;
  font-size: 25rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 112rpx !important;
  border-radius: 16rpx;
  margin-top: 80rpx;
  margin-bottom: 20rpx;
}

.avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
}

