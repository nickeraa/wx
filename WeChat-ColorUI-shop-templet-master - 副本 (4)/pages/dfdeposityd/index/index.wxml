<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title" style="font-weight: 550;">
            <text bindtap="back" class="icon-back" style="width: 40rpx;margin-left: -9rem;"></text>
            <text style="font-size: 32rpx;font-weight: 800;color:black;margin-left: 7rem;">待付款的预定单</text>
        </view>
    </view>
</view>
<view class="cu-list menu card-menu margin-top-xl  shadow-lg" style="background-color:white;margin-top:-2.5rem;">
    <view style="display: flex;width: 100%;font-size: 30rpx;">
        <view style="width: 20%;margin:20rpx 0rpx 0rpx 20rpx;">
            <image mode="widthFix" src="/img/pay.png"></image>
        </view>
        <view style="width: 80%;margin:80rpx 40rpx 0rpx 40rpx;">
            <text>等待买家付定金</text>
        </view>
    </view>
    <view style="width:90%;height: 1rpx;background-color: rgb(243, 229, 229);margin:0 auto;justify-content: center;display: flex;"></view>
</view>
<view class="cu-list menu card-menu margin-top-xl  shadow-lg">
    <view class="canui-order-item bg-white">
        <view class="head-title-box" style="margin: 0rpx 0rpx 0rpx 40rpx;">
            <view style="height: 20rpx;"></view>
            <text class="icon-shop"></text>
            <text style="margin-left: 10rpx;">广天藏品</text>
        </view>
        <view wx:for="{{replu}}" wx:key="index">
            <view class="Grid-sku" data-title="{{item.XF_PLU}}" style="height:6.5rem;border-radius:16rpx;background-color:white;margin:10rpx 0rpx 10rpx 0rpx;">
                <view catchtap="selectsku" data-XF_PLU="{{item.XF_PLU}}" style="margin-left:20rpx;margin-top:30rpx;height:200rpx;width:200rpx;">
                    <image mode="widthFix" src="{{scimgurl}}{{item.XF_PLU}}/{{item.IMAGESSL}}"></image>
                </view>
                <view class="" data-XF_PLU="{{item.XF_PLU}}" style="margin-left:30rpx;width:70%;margin-top:20rpx;">
                    <view>
                        <text>{{item.XF_DESCI}}</text>
                    </view>
                    <view>
                        <text>编号：{{item.XF_PLU}}</text>
                    </view>
                    <view style="display: flex;width:100%;">
                        <view style="color:rgb(195,167,105);margin-top:24rpx;width:30%;">
                            <text class="text-price"></text>
                            <text style="font-weight: 700;margin-left: 10rpx;">{{item.XF_PRICE}}</text>
                            <text style="font-size: 24rpx;font-weight: 700;color:rgb(195,167,105);" wx:if="{{!xiaoshu}}">.00</text>
                        </view>
                        <view style="width: 70%;margin-top:24rpx;">
                            <view style="height: 50rpx;width:10%;margin-right: 40rpx;float: right;">
                                <text style="font-size: 24rpx;">X</text>
                                <text style="margin-left: 20rpx;">{{item.XF_QTY}}</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
            <view class="cu-list menu bg-white solid-bottom canui-selet">
                <view class="cu-item">
                    <view class="content"> 共 <text class="text-red">{{item.XF_QTY}}</text> 件商品 </view>
                    <view class="action"> 小计： <text class="text-price" style="font-size: 36rpx;color:rgb(195,167,105);font-weight: 700;">{{item.SUMXF_PRICE}}</text>
                        <text style="font-size: 24rpx;font-weight: 700;color:rgb(195,167,105);" wx:if="{{!xiaoshu}}">.00</text>
                    </view>
                </view>
            </view>
        </view>
        <view class="cu-list menu bg-white solid-bottom canui-selet">
            <view class="cu-item">
                <view class="content"> 应付定金： </view>
                <view class="action">
                    <text class="text-price" style="font-size: 36rpx;color:red;font-weight: 1600rpx;">{{sumydprice}}</text>
                    <text style="font-size: 24rpx;font-weight: 700;color:red;" wx:if="{{!xiaoshu}}">.00</text>
                </view>
            </view>
        </view>
        <view class="cu-form-group bg-white canui-input">
            <view>买家留言</view>
            <input class="radius" disabled="true" style="font-size: 28rpx;margin: 4rpx 0rpx 0rpx 30rpx;color:gray;" value="{{remark}}"></input>
        </view>
        <view class="cu-form-group bg-white canui-input">
            <view>定单编号</view>
            <input class="radius" disabled="true" style="margin: 4rpx 0rpx 0rpx 30rpx;color: gray;font-size: 28rpx;" value="{{xf_docno}}"></input>
        </view>
        <view class="cu-form-group bg-white canui-input">
            <view>创建时间</view>
            <input class="radius" disabled="true" style="margin: 4rpx 0rpx 0rpx 30rpx;color: gray;font-size: 28rpx;" value="{{xf_txdate}}"></input>
        </view>
    </view>
</view>
<view style="height: 8rem;"></view>
<view class="bg-white canui-foor-fixed canui-submit-view " style="height: 6rem;">
    <view style="display: flex;width: 100%;margin-top: -20rpx;">
        <view style="margin-left: 1rem;font-size: 32rpx;margin-top: 2rem;width: 70%;">
            <text>定金合计：</text>
            <text class="text-price" style="font-size: 36rpx;color:rgb(195,167,105);font-weight: 700;">{{sumydprice}}</text>
            <text style="font-size: 24rpx;font-weight: 700;color:rgb(195,167,105);" wx:if="{{!xiaoshu}}">.00</text>
        </view>
        <view style="width: 30%;margin-top: 10rpx;">
            <button bindtap="payment" disabled="{{stop}}" class="submitbtn" style="margin: 40rpx 40rpx 40rpx 0rpx;">
                <text> 去支付</text>
            </button>
        </view>
    </view>
</view>
