<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title" style="font-weight: 550;">
            <text bindtap="back" class="icon-back" style="width: 40rpx;margin-left: -8rem;"></text>
            <text style="font-size: 32rpx;font-weight: 800;color:black;margin-left: 7rem;">快递物流查询</text>
        </view>
    </view>
</view>
<view style="margin-top: -3rem;width:3rem;"></view>
<view hidden="{{flags}}" style="margin:20rpx 20rpx 20rpx 20rpx;background-color:white;">
    <view style="height:1rem;"></view>
    <view style="height:3rem;margin-left:1rem;width:100%;display: flex;">
        <image mode="aspectFill" src="{{logo}}" style="height:160rpx;width:160rpx;"></image>
        <view style="margin-left:1rem;height:1.5rem;width:50%;margin-top:16rpx;font-weight:700;">
            <text style="font-size:50rpx">{{expName}}</text>
            <view style="height:1.5rem;margin-top:32rpx;color:gray;">{{kdnumber}}</view>
        </view>
    </view>
    <view style="border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);margin-top:60rpx;"></view>
    <view class="icon-roundcheckfill" style="margin:60rpx 0rpx 20rpx 40rpx;color:green;">
        <text space="nbsp" style="margin-left:10rpx;;font-weight:900;">{{deliverystatus}}  {{updateTime}}</text>
    </view>
    <view style="margin:2rpx 0rpx 20rpx 40rpx;">
        <text style="margin-left:10rpx;;color:gray;">{{newstatus}}</text>
    </view>
    <view hidden="{{views}}" wx:for="{{listwl}}" wx:key="index">
        <view class="icon-roundcheckfill " style="margin:40rpx 0rpx 20rpx 40rpx;">
            <text space="nbsp" style="color:gray;margin-left:10rpx;color:black;">  {{item.time}}</text>
        </view>
        <view style="margin:2rpx 0rpx 20rpx 40rpx;">
            <text style="margin-left:10rpx;color:gray;">{{item.status}}</text>
        </view>
    </view>
    <view>
        <view catchtap="cs" style="display:flex;width:100%;padding-bottom:200rpx;height:3rem;">
            <view style="margin-left:7rem;;color:gray;margin-top:60rpx;width:25%;">{{states}}</view>
            <view class="{{css}}" style="width:5%;margin-top:64rpx;"></view>
        </view>
    </view>
</view>
