<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title" style="font-weight: 550;">
            <text bindtap="back" class="icon-back" style="width: 40rpx;margin-left: -7rem;"></text>
            <text style="font-size: 32rpx;font-weight: 800;color:black;margin-left: 7rem;">收货地址</text>
        </view>
    </view>
</view>
<view bindtap="edit" class="cu-list menu card-menu  shadow-lg" data-id="{{item.ID}}" style="background-color:white;" wx:for="{{replu}}" wx:key="index">
    <view style="margin:40rpx 0rpx 0rpx 40rpx;">
        <text class="text-black">{{item.ADDRESS1}}{{item.ADDRESS2}}</text>
    </view>
    <view style="display: flex;width: 100%;">
        <view style="width:30%;margin-top: 40rpx;margin-left: 40rpx; background-color: rgb(195, 167, 105); color: white;border-radius: 20rpx;align-items: center;justify-content: center;display: flex;" wx:if="{{item.TAG=='1'}}">默认</view>
        <view style="width:40%;margin-top: 40rpx;margin-left: 40rpx;color:gray;">
            <text>{{item.BODY}}</text>
        </view>
        <view style="width:20%;margin-top: 46rpx;margin-left: 40rpx;color:gray;">
            <text>{{item.PHONE}}</text>
        </view>
        <view style="margin-top: 40rpx;width:100%;">
            <text class="icon-writefill" style="float: right;color:gray;margin-right: 40rpx;"></text>
        </view>
    </view>
    <view style="height: 20rpx;background-color:white"></view>
    <view style="height: 2rpx;background-color: rgb(239, 235, 239);"></view>
</view>
<view style="height:5rem;"></view>
<view class="bg-white canui-foor-fixed canui-submit-view " style="height: 5rem;display: flex;width: 100%;align-items: center;justify-content: center;">
    <button bindtap="add" class="submitbtn" style="margin: 20rpx 0rpx 40rpx 0rpx;width:80%;height: 2.5rem;">
        <text> 新增收货地址</text>
    </button>
</view>
