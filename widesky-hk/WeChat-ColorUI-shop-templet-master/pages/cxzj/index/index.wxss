page {
  background: #f1f1f1;
  overflow-x: hidden;
}

/* 自定义导航栏 */
.cu-custom {
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 99;
}
.cu-custom .cu-bar {
  background-image: linear-gradient(45deg, #ff9700, #ed1c24);
  padding-right: inherit;
}

/* 查询区 */
.search-box {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 43, 107, 0.08);
}
.search-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #efe8f7;
  padding-bottom: 20rpx;
}
.search-label {
  width: 160rpx;
  color: #4a2b6b;
  font-size: 30rpx;
  font-weight: 600;
}
.search-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}
.search-ph {
  color: #c3bcd0;
  font-size: 30rpx;
}
.search-btn {
  margin-top: 30rpx;
  text-align: center;
  background: linear-gradient(45deg, #ff9700, #ed1c24);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(237, 28, 36, 0.25);
}
.search-btn.disabled {
  opacity: 0.6;
}

/* 占位 / 空态 */
.placeholder {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.placeholder-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.85;
}
.warn-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e6, #ffeec2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 151, 0, 0.18);
}
.warn-img {
  width: 90rpx;
  height: 90rpx;
}
.placeholder-title {
  margin-top: 30rpx;
  color: #3d2b52;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.placeholder-text {
  margin-top: 20rpx;
  color: #9b8bab;
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
.reset-btn {
  margin-top: 40rpx;
  width: 320rpx;
  text-align: center;
  color: #ed1c24;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #ed1c24;
  border-radius: 999rpx;
  padding: 16rpx 0;
}

/* 中奖但尚未领奖：奖品展示 */
.notreceived-prize-box {
  width: 320rpx;
  height: 320rpx;
  border: 4rpx solid #b7d9cf;
  border-radius: 24rpx;
  background: #f5fbf9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-top: 20rpx;
}
.notreceived-prize-img {
  width: 280rpx;
  height: 280rpx;
}
.notreceived-prize-name {
  margin-top: 30rpx;
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

/* 抽奖领奖凭证 */
.cert {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 50rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 43, 107, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cert-title {
  color: #ed1c24;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-align: center;
}
.cert-line {
  width: 100%;
  height: 2rpx;
  background: #eeeeee;
  margin: 30rpx 0 40rpx;
}
.cert-prize-box {
  width: 320rpx;
  height: 320rpx;
  border: 4rpx solid #b7d9cf;
  border-radius: 24rpx;
  background: #f5fbf9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cert-prize-img {
  width: 280rpx;
  height: 280rpx;
}
.cert-prize-name {
  margin: 30rpx 0 40rpx;
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}
.cert-rows {
  width: 100%;
}
.cert-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}
.cert-label {
  width: 180rpx;
  flex-shrink: 0;
  color: #888888;
  font-size: 30rpx;
}
.cert-value {
  flex: 1;
  color: #333;
  font-size: 30rpx;
  word-break: break-all;
}
.cert-tip {
  margin-top: 40rpx;
  color: #bbbbbb;
  font-size: 24rpx;
  text-align: center;
}
