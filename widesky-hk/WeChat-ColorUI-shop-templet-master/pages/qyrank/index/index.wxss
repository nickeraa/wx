page {
  background: #f1f1f1;
  width: 100%;
}
.cu-custom {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 999;
}
.cu-custom .cu-bar {
  background-image: linear-gradient(45deg, #ff9700, #ed1c24);
  padding-right: inherit;
}
.head-title { margin: 0 auto; color: #fff; }
.back-btn {
  position: absolute;
  left: 24rpx;
  top: 0;
  height: 100%;
  display: flex;
  align-items: center;
  color: #fff;
  font-size: 44rpx;
}
.page-wrap {
  padding: 20rpx 24rpx 60rpx;
  margin-top: 160rpx;
}
.loading { text-align: center; color: #999; padding: 100rpx 0; }

.rank-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.rank-item:last-child { border-bottom: none; }
.rank-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.rank-no.top3 {
  background: linear-gradient(45deg, #ff9700, #ed1c24);
  color: #fff;
}
.rank-info { flex: 1; }
.rank-name { color: #333; font-size: 32rpx; font-weight: 600; }
.rank-cnt { color: #4a2b6b; font-size: 30rpx; font-weight: 700; }
.empty { text-align: center; color: #999; padding: 40rpx 0; }

/* 明细弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}
.detail-dialog {
  width: 620rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 30rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  background-image: linear-gradient(45deg, #ff9700, #ed1c24);
  letter-spacing: 2rpx;
}
.detail-close { color: #fff; font-size: 34rpx; padding: 0 10rpx; opacity: 0.9; }
.detail-scroll {
  max-height: 60vh;
  padding: 0 30rpx;
}
.detail-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-item:last-child { border-bottom: none; }
.detail-name { color: #333; font-size: 30rpx; font-weight: 600; }
.detail-time { color: #b0b0b0; font-size: 24rpx; margin-top: 8rpx; }
