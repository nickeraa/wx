<!-- 自定义导航栏 -->
<view class="cu-custom" style="height:{{CustomBar}}px;">
  <view class="cu-bar fixed none-bg text-white bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
    <view bindtap="back" class="action canui-head-title">
      <text class="icon-back"></text>国庆抽奖领奖查询
    </view>
  </view>
</view>
<view style="height:{{CustomBar}}px;"></view>

<!-- 查询区 -->
<view class="search-box">
  <view class="search-row">
    <view class="search-label">会员卡号</view>
    <input class="search-input" type="text" placeholder="请输入会员卡号" placeholder-class="search-ph" value="{{card}}" bindinput="onCardInput" />
  </view>
  <view class="search-btn {{querying?'disabled':''}}" bindtap="onQuery">{{querying?'查询中...':'查 询'}}</view>
</view>

<!-- 未查询：引导 -->
<view wx:if="{{!searched}}" class="placeholder">
  <image class="placeholder-img" src="/images/nodata.jpg" mode="aspectFit"></image>
  <view class="placeholder-text">输入会员卡号，查询该会员的国庆抽奖中奖情况</view>
</view>

<!-- 没有中奖记录 -->
<view wx:elif="{{noPrize}}" class="placeholder">
  <view class="warn-badge">
    <image class="warn-img" src="https://widesky.work/HKback/images/jg.jpg" mode="aspectFit"></image>
  </view>
  <view class="placeholder-title">没有参与抽奖</view>
  <view class="placeholder-text">该会员没有参与国庆抽奖记录，请核对会员卡号</view>
  <view class="reset-btn" bindtap="onReset">重新查询</view>
</view>

<!-- 查询结果：中奖记录列表 -->
<view wx:else class="cert">
  <view class="cert-title">国庆抽奖中奖记录</view>
  <view class="cert-line"></view>

  <view class="record-vip">
    <text wx:if="{{memberCard}}">会员卡号：{{memberCard}}</text>
    <text wx:if="{{vipName}}">　{{vipName}}</text>
    <text wx:if="{{vipLevel}}">（{{vipLevel}}）</text>
  </view>

  <view class="record-item" wx:for="{{records}}" wx:key="index">
    <view class="record-img-box">
      <image class="record-img" src="{{item.prizeImg}}" mode="aspectFit" wx:if="{{item.prizeImg}}"></image>
    </view>
    <view class="record-info">
      <view class="record-name">{{item.prizeName}}</view>
      <view class="record-status {{item.received?'done':'todo'}}">{{item.received?'已领取':'待领取'}}</view>
      <view class="record-time" wx:if="{{item.cjTime}}">中奖时间：{{item.cjTime}}</view>
      <view class="record-time" wx:if="{{item.received && item.ljTime}}">领取时间：{{item.ljTime}}</view>
      <view class="cert-btn" wx:if="{{item.received}}" bindtap="onViewCert" data-idx="{{index}}">核销凭证</view>
    </view>
  </view>

  <view class="cert-tip">该会员共 {{records.length}} 条国庆抽奖中奖记录</view>
  <view class="reset-btn" bindtap="onReset">重新查询</view>
</view>

<!-- 领奖核销凭证弹窗 -->
<view class="cert-mask" wx:if="{{showCert}}" bindtap="onCloseCert">
  <view class="cert-pop" catchtap="">
    <view class="cert-pop-title">国庆抽奖领奖凭证</view>
    <view class="cert-pop-line"></view>

    <view class="cert-pop-prize-box">
      <image class="cert-pop-prize-img" src="{{cert.prizeImg}}" mode="aspectFit"></image>
    </view>
    <view class="cert-pop-prize-name">{{cert.prizeName}}</view>

    <view class="cert-pop-rows">
      <view class="cert-pop-row" wx:if="{{cert.memberCard}}">
        <text class="cert-pop-label">会员卡号：</text>
        <text class="cert-pop-value">{{cert.memberCard}}</text>
      </view>
      <view class="cert-pop-row" wx:if="{{cert.vipName}}">
        <text class="cert-pop-label">会员姓名：</text>
        <text class="cert-pop-value">{{cert.vipName}}</text>
      </view>
      <view class="cert-pop-row" wx:if="{{cert.vipLevel}}">
        <text class="cert-pop-label">会员等级：</text>
        <text class="cert-pop-value">{{cert.vipLevel}}</text>
      </view>
      <view class="cert-pop-row" wx:if="{{cert.staffId}}">
        <text class="cert-pop-label">员工工号：</text>
        <text class="cert-pop-value">{{cert.staffId}}</text>
      </view>
      <view class="cert-pop-row" wx:if="{{cert.staffName}}">
        <text class="cert-pop-label">员工姓名：</text>
        <text class="cert-pop-value">{{cert.staffName}}</text>
      </view>
      <view class="cert-pop-row" wx:if="{{cert.shopNo}}">
        <text class="cert-pop-label">店铺号：</text>
        <text class="cert-pop-value">{{cert.shopNo}}</text>
      </view>
      <view class="cert-pop-row" wx:if="{{cert.receivedTime}}">
        <text class="cert-pop-label">核销时间：</text>
        <text class="cert-pop-value">{{cert.receivedTime}}</text>
      </view>
    </view>

    <view class="cert-pop-tip">请将本凭证附在销售单据后作为领奖依据</view>

    <view class="cert-pop-btns">
      <view class="cert-pop-btn save {{saving?'disabled':''}}" bindtap="saveCert">{{saving?'保存中...':'保存凭证'}}</view>
      <view class="cert-pop-btn close" bindtap="onCloseCert">关 闭</view>
    </view>
  </view>
</view>

<!-- 凭证导出用隐藏画布 -->
<canvas type="2d" id="certCanvas" style="position:fixed;left:-9999px;top:-9999px;width:600px;height:1000px;"></canvas>
