page {
  background: #f1f1f1;
  overflow-x: hidden;
}

/* 自定义导航栏 */
.cu-custom {
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 99;
}
.cu-custom .cu-bar {
  background-image: linear-gradient(45deg, #ff9700, #ed1c24);
  padding-right: inherit;
}

/* 查询区 */
.search-box {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 43, 107, 0.08);
}
.search-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #efe8f7;
  padding-bottom: 20rpx;
}
.search-label {
  width: 160rpx;
  color: #4a2b6b;
  font-size: 30rpx;
  font-weight: 600;
}
.search-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}
.search-ph {
  color: #c3bcd0;
  font-size: 30rpx;
}
.search-btn {
  margin-top: 30rpx;
  text-align: center;
  background: linear-gradient(45deg, #ff9700, #ed1c24);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(237, 28, 36, 0.25);
}
.search-btn.disabled {
  opacity: 0.6;
}

/* 占位 / 空态 */
.placeholder {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.placeholder-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.85;
}
.warn-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e6, #ffeec2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 151, 0, 0.18);
}
.warn-img {
  width: 90rpx;
  height: 90rpx;
}
.placeholder-title {
  margin-top: 30rpx;
  color: #3d2b52;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.placeholder-text {
  margin-top: 20rpx;
  color: #9b8bab;
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
.reset-btn {
  margin-top: 40rpx;
  width: 320rpx;
  text-align: center;
  color: #ed1c24;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #ed1c24;
  border-radius: 999rpx;
  padding: 16rpx 0;
}

/* 中奖但尚未领奖：奖品展示 */
.notreceived-prize-box {
  width: 320rpx;
  height: 320rpx;
  border: 4rpx solid #b7d9cf;
  border-radius: 24rpx;
  background: #f5fbf9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-top: 20rpx;
}
.notreceived-prize-img {
  width: 280rpx;
  height: 280rpx;
}
.notreceived-prize-name {
  margin-top: 30rpx;
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

/* 抽奖领奖凭证 */
.cert {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 50rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 43, 107, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cert-title {
  color: #ed1c24;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-align: center;
}
.cert-line {
  width: 100%;
  height: 2rpx;
  background: #eeeeee;
  margin: 30rpx 0 40rpx;
}
.cert-prize-box {
  width: 320rpx;
  height: 320rpx;
  border: 4rpx solid #b7d9cf;
  border-radius: 24rpx;
  background: #f5fbf9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cert-prize-img {
  width: 280rpx;
  height: 280rpx;
}
.cert-prize-name {
  margin: 30rpx 0 40rpx;
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}
.cert-rows {
  width: 100%;
}
.cert-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}
.cert-label {
  width: 180rpx;
  flex-shrink: 0;
  color: #888888;
  font-size: 30rpx;
}
.cert-value {
  flex: 1;
  color: #333;
  font-size: 30rpx;
  word-break: break-all;
}
.cert-tip {
  margin-top: 40rpx;
  color: #bbbbbb;
  font-size: 24rpx;
  text-align: center;
}

/* 查询结果：中奖记录列表 */
.record-vip {
  width: 100%;
  padding-bottom: 24rpx;
  color: #4a2b6b;
  font-size: 28rpx;
  font-weight: 600;
}
.record-item {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid #f2f2f2;
}
.record-img-box {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border: 4rpx solid #b7d9cf;
  border-radius: 20rpx;
  background: #f5fbf9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.record-img {
  width: 140rpx;
  height: 140rpx;
}
.record-info {
  flex: 1;
  margin-left: 24rpx;
}
.record-name {
  color: #333;
  font-size: 34rpx;
  font-weight: 700;
}
.record-status {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.record-status.todo {
  color: #ed1c24;
  background: #fdeceb;
}
.record-status.done {
  color: #0f9d58;
  background: #e8f7ee;
}
.record-time {
  margin-top: 12rpx;
  color: #999999;
  font-size: 24rpx;
}
.cert .reset-btn {
  margin-top: 40rpx;
}
/* 记录行内：核销凭证按钮（仅已领取显示） */
.cert-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 28rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(45deg, #ff9700, #ed1c24);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.25);
}

/* 领奖核销凭证弹窗 */
.cert-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cert-pop {
  width: 620rpx;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cert-pop-title {
  color: #ed1c24;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  text-align: center;
}
.cert-pop-line {
  width: 100%;
  height: 2rpx;
  background: #eeeeee;
  margin: 24rpx 0 30rpx;
}
.cert-pop-prize-box {
  width: 280rpx;
  height: 280rpx;
  border: 4rpx solid #b7d9cf;
  border-radius: 24rpx;
  background: #f5fbf9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cert-pop-prize-img {
  width: 240rpx;
  height: 240rpx;
}
.cert-pop-prize-name {
  margin-top: 24rpx;
  color: #333;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}
.cert-pop-rows {
  width: 100%;
  margin-top: 10rpx;
}
.cert-pop-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}
.cert-pop-label {
  width: 180rpx;
  flex-shrink: 0;
  color: #888888;
  font-size: 28rpx;
}
.cert-pop-value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  word-break: break-all;
}
.cert-pop-tip {
  margin-top: 30rpx;
  color: #bbbbbb;
  font-size: 22rpx;
  text-align: center;
}
.cert-pop-btns {
  width: 100%;
  display: flex;
  margin-top: 36rpx;
}
.cert-pop-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.cert-pop-btn.save {
  color: #fff;
  background: linear-gradient(45deg, #ff9700, #ed1c24);
  margin-right: 20rpx;
}
.cert-pop-btn.save.disabled {
  opacity: 0.6;
}
.cert-pop-btn.close {
  color: #666;
  border: 2rpx solid #ddd;
}
