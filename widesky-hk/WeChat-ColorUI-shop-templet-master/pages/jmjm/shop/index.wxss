/* 店铺设定页 */
.jm-bar {
  background: linear-gradient(135deg, #c8a35f, #a8741a);
  display: flex;
  align-items: center;
}
.jm-bar-back {
  width: 60rpx;
  text-align: center;
  color: #fff;
  font-size: 44rpx;
  line-height: 1;
}
.jm-bar-title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.jm-bar-right {
  min-width: 60rpx;
  padding-right: 20rpx;
  text-align: right;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
}

.shop-page {
  padding: 24rpx 24rpx 60rpx;
}

/* 当前归属 */
.shop-current {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff7e8;
  border-radius: 12rpx;
}
.shop-current-label {
  font-size: 26rpx;
  color: #b8860b;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.shop-current-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

/* 店铺列表 */
.shop-loading {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.shop-loading-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: #f0ede6;
  overflow: hidden;
  position: relative;
}
.shop-loading-bar::after {
  content: '';
  position: absolute;
  left: -40%;
  top: 0;
  height: 100%;
  width: 40%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #c8a35f, #a8741a);
  animation: shopbar 1s linear infinite;
}
@keyframes shopbar {
  0% { left: -40%; }
  100% { left: 100%; }
}
.shop-loading-tip {
  margin-top: 20rpx;
  text-align: center;
  color: #9b8bab;
  font-size: 26rpx;
}
.shop-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.shop-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0ede6;
}
.shop-item:last-child {
  border-bottom: none;
}
.shop-item.active {
  background: #fff7e8;
}
.shop-item-main {
  display: flex;
  align-items: baseline;
}
.shop-item-no {
  font-size: 30rpx;
  color: #b8860b;
  font-weight: 700;
  margin-right: 18rpx;
}
.shop-item-name {
  font-size: 28rpx;
  color: #333;
}
.shop-item.active .shop-item-name {
  font-weight: 700;
}
.shop-check {
  color: #0aab52;
  font-size: 32rpx;
  font-weight: 700;
}
.shop-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9b8bab;
  font-size: 26rpx;
}

/* 确认按钮 */
.shop-save {
  margin-top: 40rpx;
  padding: 24rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #c8a35f, #a8741a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
}
.shop-save.disabled {
  opacity: 0.6;
}
