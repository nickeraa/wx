/* ============ 金银币寄卖·客户确认页 ============ */
page {
  background: #f1f1f1;
}

/* 顶部导航（渐变金棕，同开单页） */
.jm-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: linear-gradient(45deg, #b8860b, #ff9700);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(184, 134, 11, 0.35);
}
.jm-bar-back {
  width: 80rpx;
  text-align: center;
  font-size: 44rpx;
  line-height: 90rpx;
}
.jm-bar-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 90rpx;
}
.jm-bar-right {
  width: 200rpx;
  text-align: center;
  font-size: 22rpx;
  opacity: 0.9;
  line-height: 90rpx;
  overflow: hidden;
  white-space: nowrap;
}

.jm-page {
  padding: 24rpx 24rpx 60rpx;
}
.loading-tip {
  text-align: center;
  color: #9b8bab;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.jm-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 82, 0.08);
}
.jm-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3d2b52;
  margin-bottom: 24rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid #b8860b;
}
.empty-tip {
  text-align: center;
  color: #9b8bab;
  font-size: 28rpx;
  padding: 40rpx 0;
}

/* 货品信息 */
.goods-img {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: #faf8fd;
  margin-bottom: 24rpx;
}
.goods-row {
  display: flex;
  margin-top: 16rpx;
}
.goods-row.three .goods-cell {
  flex: 1;
}
.goods-cell {
  flex: 1;
}
.goods-cell-label {
  font-size: 24rpx;
  color: #9b8bab;
}
.goods-cell-val {
  font-size: 30rpx;
  color: #3d2b52;
  font-weight: 600;
  margin-top: 8rpx;
  word-break: break-all;
}
.goods-cell-val.price {
  color: #b8860b;
  font-size: 34rpx;
}

/* 多货品明细 */
.item-card {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}
.item-imgs {
  display: flex;
  flex-wrap: wrap;
  width: 240rpx;
  flex-shrink: 0;
}
.item-img-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  margin: 0 8rpx 8rpx 0;
  background: #faf8fd;
}
.item-img-empty {
  color: #9b8bab;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-img-count {
  font-size: 22rpx;
  color: #9b8bab;
  margin-top: 6rpx;
}
.item-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.item-name {
  font-size: 30rpx;
  color: #3d2b52;
  font-weight: 600;
  word-break: break-all;
}
.item-meta {
  font-size: 26rpx;
  color: #b8860b;
  margin-top: 8rpx;
}
.goods-total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding-top: 22rpx;
}
.goods-total-label {
  font-size: 26rpx;
  color: #9b8bab;
  margin-right: 12rpx;
}
.goods-total-price {
  font-size: 38rpx;
  font-weight: 700;
  color: #b8860b;
}
.goods-total-qty {
  font-size: 24rpx;
  color: #9b8bab;
  margin-left: 16rpx;
}
.goods-date {
  text-align: right;
  font-size: 24rpx;
  color: #9b8bab;
  margin-top: 12rpx;
}

/* 客户表单 */
.form-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}
.form-label {
  width: 170rpx;
  font-size: 30rpx;
  color: #3d2b52;
  font-weight: 600;
}
.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #4a2b6b;
  text-align: right;
}
.form-err {
  color: #e64340;
  font-size: 26rpx;
  margin-top: 16rpx;
}
.form-section {
  font-size: 26rpx;
  color: #b8860b;
  font-weight: 600;
  margin-top: 26rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f0ede8;
}
.submit-btn {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: linear-gradient(45deg, #b8860b, #ff9700);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(184, 134, 11, 0.4);
}
.submit-btn.disabled {
  opacity: 0.6;
}
.sign-note {
  text-align: center;
  font-size: 22rpx;
  color: #9b8bab;
  margin-top: 20rpx;
}

/* 等待签署 */
.signing-icon {
  font-size: 80rpx;
  text-align: center;
  padding-top: 20rpx;
}
.signing-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2b52;
  margin-top: 16rpx;
}
.signing-sub {
  text-align: center;
  font-size: 26rpx;
  color: #9b8bab;
  margin-top: 12rpx;
  line-height: 1.7;
}
.poll-dot {
  text-align: center;
  font-size: 24rpx;
  color: #b8860b;
  margin-top: 24rpx;
}

/* 签署完成 */
.done-card {
  text-align: center;
  padding: 80rpx 28rpx;
}
.done-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #2ee56c;
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
}
.done-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3d2b52;
}
.done-sub {
  font-size: 26rpx;
  color: #9b8bab;
  margin-top: 12rpx;
}

/* 签署失败 */
.fail-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #e64340;
  padding-top: 20rpx;
}
.fail-sub {
  text-align: center;
  font-size: 26rpx;
  color: #9b8bab;
  margin: 16rpx 0 32rpx;
  word-break: break-all;
}
