/* 我的中奖页面：参考 lqjp 风格（渐变导航 + 头部背景水波 + 白色卡片） */
page {
  overflow-x: hidden;
  padding-top: 50px;
  width: 100%;
  background: #f1f1f1;
}

/* 自定义导航栏 */
.cu-custom {
  position: absolute;
  top: 0;
  width: 100%;
}
.cu-custom .cu-bar {
  background-image: linear-gradient(45deg, #ff9700, #ed1c24);
  padding-right: inherit;
}
.head-title {
  margin: 0 auto;
}

/* 头部背景图 + 水波动画 */
.UCenter-bg {
  align-items: center;
  background-image: url(https://widesky.work/HKback/upload/bg2.jpg);
  background-size: cover;
  color: #fff;
  display: flex;
  flex-direction: column;
  height: 400rpx;
  justify-content: center;
  overflow: hidden;
  position: relative;
  text-shadow: 0 0 3px rgba(0, 0, 0, 0.3);
}
.UCenter-bg .css-wave {
  bottom: 0;
  height: 60rpx;
  left: 0;
  mix-blend-mode: screen;
  overflow: hidden;
  position: absolute;
  width: 100%;
  z-index: 99;
}
.UCenter-bg .css-wave .wave {
  animation: wave-rotate 10s linear infinite;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 43%;
  bottom: -930rpx;
  height: 1000rpx;
  left: 50%;
  margin-left: -500rpx;
  position: absolute;
  width: 1000rpx;
}
.UCenter-bg .css-wave .wave2 {
  animation-duration: 14s;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 47%;
}
.UCenter-bg .css-wave .wave3 {
  animation-direction: reverse;
  animation-duration: 7s;
  background-color: rgba(255, 255, 255, 0.35);
  border-radius: 40%;
}
@keyframes wave-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 内容卡片 */
.content-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 30rpx;
  min-height: 860rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

/* 状态提示 */
.state-tip {
  color: #4a2b6b;
  font-size: 32rpx;
}

/* 查询中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: loading-in 0.6s ease-out both;
}
.loading-wrap .state-tip {
  color: #4a2b6b;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-shadow: 0 0 16rpx rgba(74, 43, 107, 0.35);
  animation: loading-tip-pulse 1.8s ease-in-out infinite;
}
.loading-bar {
  width: 340rpx;
  height: 18rpx;
  margin-top: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffe9a8, #ffb300, #ffe9a8);
  background-size: 200% 100%;
  box-shadow: 0 0 24rpx rgba(255, 179, 0, 0.55);
  animation: loading-shimmer 1.1s linear infinite;
}
@keyframes loading-shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
@keyframes loading-tip-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}
@keyframes loading-in {
  from { opacity: 0; transform: translateY(40rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* 无中奖 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.warn-badge {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e6, #ffeec2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 60rpx rgba(255, 151, 0, 0.35);
  margin-bottom: 40rpx;
  animation: warn-pulse 2s ease-in-out infinite;
}
.warn-img {
  width: 130rpx;
  height: 130rpx;
}
@keyframes warn-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 16rpx 60rpx rgba(255, 151, 0, 0.35); }
  50% { transform: scale(1.06); box-shadow: 0 20rpx 72rpx rgba(255, 151, 0, 0.5); }
}
.empty-title {
  color: #3d2b52;
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 40rpx;
  letter-spacing: 2rpx;
}
.empty-sub {
  color: #9b8bab;
  font-size: 26rpx;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

/* 恭喜中奖标题 */
.fly-title {
  position: relative;
  z-index: 2;
  background: linear-gradient(45deg, #ff9700, #ed1c24 55%, #ff9700);
  background-size: 220% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 8rpx 22rpx rgba(255, 151, 0, 0.5));
  animation: fly-title-in 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both, title-slide 5s linear 0.9s infinite, title-pulse 2.6s ease-in-out 1.1s infinite;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  padding-left: 28rpx;
  width: 440rpx;
  text-align: center;
  white-space: nowrap;
  margin-bottom: 30rpx;
}
@keyframes fly-title-in {
  0% { opacity: 0; transform: translateY(-120rpx) scale(0.5); }
  70% { transform: translateY(10rpx) scale(1.1); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes title-slide {
  0% { background-position: 0% 0; }
  100% { background-position: 220% 0; }
}
@keyframes title-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

/* 奖品图 */
.prize-show-img {
  width: 420rpx;
  height: 420rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 43, 107, 0.12);
}
.prize-name {
  color: #4a2b6b;
  font-size: 44rpx;
  font-weight: 700;
  margin: 30rpx 0 40rpx;
}

/* 信息卡片 */
.recv-card {
  width: 100%;
  background: #faf8fd;
  border-radius: 16rpx;
  padding: 8rpx 30rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #efe8f7;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  color: #9b8bab;
  font-size: 28rpx;
}
.info-value {
  color: #3d2b52;
  font-size: 28rpx;
  font-weight: 600;
}
/* 领取状态颜色：待领取红色，已领取绿色 */
.status-pending {
  color: #ed1c24;
}
.status-received {
  color: #2ee56c;
}
