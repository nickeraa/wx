/* 极简抽奖页 */
page {
  overflow-x: hidden;
  width: 100%;
  height: 100%;
}

/* 全屏背景 */
.bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.cu-custom {
  position: absolute;
  top: 0;
  width: 100%;
}
.cu-custom .cu-bar {
  background-image: linear-gradient(45deg, #ff9700, #ed1c24);
  padding-right: inherit;
}
.head-title {
  margin: 0 auto;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding-top: 120rpx;
}

/* 九宫格 */
.frame_view {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.frame_row {
  display: flex;
  flex-direction: row;
}
.frame_item {
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}
.frame_img {
  width: 160rpx;
  height: 160rpx;
}
.luck_btn {
  background: transparent;
  box-shadow: none;
}
.luck_disabled {
  opacity: 0.6;
}

.tip-text {
  margin-top: 30rpx;
  color: #4a2b6b;
  font-size: 30rpx;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
}

/* 通用提示弹窗 */
.notice-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 3rpx solid rgba(255, 217, 94, 0.65);
  padding: 44rpx 32rpx 32rpx;
}
.notice-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #b8860b;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.notice-body {
  text-align: center;
  font-size: 30rpx;
  color: #4a2b6b;
  line-height: 1.8;
  margin-bottom: 34rpx;
}
.notice-btn {
  margin: 0 auto;
  width: 280rpx;
  text-align: center;
  background: #b8860b;
  color: #fff;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 16rpx 0;
}

/* 中奖飞入动画层 */
.fly-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 46%, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.72) 78%);
}

/* 舞台聚光灯 */
.fly-spot {
  position: absolute;
  top: -5vh;
  width: 260rpx;
  height: 62vh;
  background: linear-gradient(180deg, rgba(255, 236, 170, 0.55), rgba(255, 236, 170, 0));
  clip-path: polygon(50% 0, 0 100%, 100% 100%);
  filter: blur(6rpx);
  opacity: 0;
  animation: spotIn 0.6s ease-out 0.5s forwards;
}
.spot-left {
  left: 12%;
  transform-origin: top center;
  transform: rotate(14deg);
}
.spot-right {
  right: 12%;
  transform-origin: top center;
  transform: rotate(-14deg);
}
@keyframes spotIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 舞台地面光斑 */
.fly-glow-floor {
  position: absolute;
  top: 58%;
  left: 50%;
  width: 480rpx;
  height: 160rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 236, 170, 0.55), rgba(255, 236, 170, 0) 70%);
  opacity: 0;
  animation: spotIn 0.6s ease-out 0.65s forwards;
}
.fly-prize {
  width: 420rpx;
  height: 420rpx;
  border-radius: 32rpx;
  filter: drop-shadow(0 0 30rpx rgba(255, 217, 94, 0.9));
  animation: flyIn 0.8s cubic-bezier(0.22, 1.4, 0.36, 1) forwards, flyShake 0.6s ease-in-out 0.85s 3;
}
@keyframes flyIn {
  0% { transform: translateY(-110vh) scale(0.6) rotate(-12deg); opacity: 0; }
  60% { opacity: 1; }
  80% { transform: translateY(30rpx) scale(1.05) rotate(3deg); }
  100% { transform: translateY(0) scale(1) rotate(0); opacity: 1; }
}
@keyframes flyShake {
  0%, 100% { transform: translateX(0) rotate(0); }
  20% { transform: translateX(-16rpx) rotate(-4deg); }
  40% { transform: translateX(16rpx) rotate(4deg); }
  60% { transform: translateX(-10rpx) rotate(-3deg); }
  80% { transform: translateX(10rpx) rotate(2deg); }
}

/* 旋转光芒 */
.fly-rays {
  position: absolute;
  width: 760rpx;
  height: 760rpx;
  border-radius: 50%;
  background: repeating-conic-gradient(rgba(255, 217, 94, 0.35) 0deg 12deg, transparent 12deg 30deg);
  opacity: 0;
  animation: raysIn 0.5s ease-out 0.55s forwards, raysRotate 2.5s linear 0.55s infinite;
}
@keyframes raysIn {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes raysRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 脉冲光环 */
.fly-pulse {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 217, 94, 0.85);
  opacity: 0;
  animation: pulseOut 1.1s ease-out 0.75s 4;
}
@keyframes pulseOut {
  0% { transform: scale(0.5); opacity: 1; }
  100% { transform: scale(2.4); opacity: 0; }
}

/* 烟花粒子 */
.spark {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--c, #ffd95e);
  box-shadow: 0 0 12rpx var(--c, #ffd95e);
  opacity: 0;
  animation: sparkFly 1.2s ease-out var(--d, 0.8s) 2;
}
@keyframes sparkFly {
  0% { transform: translate(0, 0) scale(1.2); opacity: 1; }
  70% { opacity: 1; }
  100% { transform: translate(var(--x), var(--y)) scale(0.2); opacity: 0; }
}

/* 彩带飘落 */
.confetti {
  position: absolute;
  top: -40rpx;
  width: 16rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--c, #ff5a5f);
  opacity: 0;
  animation: confettiFall 3s ease-in var(--d, 0.2s) forwards;
}
@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) rotate(720deg); opacity: 0.7; }
}

/* 中奖内容容器 */
.fly-prize-box {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}
.fly-title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  padding: 14rpx 40rpx 14rpx 46rpx;
  text-align: center;
  color: #ff3b30;
  background: rgba(18, 18, 18, 0.9);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.35);
  margin-bottom: 30rpx;
  opacity: 0;
  animation: titleDrop 0.9s cubic-bezier(0.22, 1.2, 0.36, 1) 0.3s forwards, titleShake 0.5s ease-in-out 1.3s 2, titleBeat 0.9s ease-in-out 2.4s infinite;
}
@keyframes titleBeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
@keyframes titleDrop {
  0% { transform: translateY(-100vh) scale(1.2); opacity: 0; }
  60% { opacity: 1; }
  80% { transform: translateY(24rpx); }
  100% { transform: translateY(0); opacity: 1; }
}
@keyframes titleShake {
  0%, 100% { transform: translateX(0) rotate(0); }
  25% { transform: translateX(-10rpx) rotate(-3deg); }
  50% { transform: translateX(10rpx) rotate(3deg); }
  75% { transform: translateX(-6rpx) rotate(-2deg); }
}
@keyframes titlePop {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.fly-img-wrap {
  position: relative;
}

/* 温馨提醒弹窗 */
.notice-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 3rpx solid rgba(255, 217, 94, 0.65);
  padding: 44rpx 32rpx 32rpx;
  position: relative;
}
.notice-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  color: #999;
  font-size: 32rpx;
}
.notice-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #b8860b;
  letter-spacing: 4rpx;
  margin-bottom: 22rpx;
}
.notice-body {
  text-align: center;
  font-size: 28rpx;
  color: #4a2b6b;
  line-height: 1.8;
  margin-bottom: 30rpx;
}
.notice-hl {
  color: #e45c5c;
  font-weight: 700;
}
.notice-btn {
  margin: 0 auto;
  width: 280rpx;
  text-align: center;
  background: #b8860b;
  color: #fff;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 16rpx 0;
}
.notice-loading {
  width: 300rpx;
  height: 12rpx;
  margin: 70rpx auto 100rpx;
  border-radius: 999rpx;
  background: rgba(184, 134, 11, 0.15);
  overflow: hidden;
  position: relative;
}
.notice-loading::after {
  content: '';
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd95e, #b8860b);
  animation: loadingSlide 1s ease-in-out infinite;
}
@keyframes loadingSlide {
  0% { left: -40%; }
  100% { left: 100%; }
}

/* 关注公众号按钮 */
.fly-follow {
  margin-top: 44rpx;
  background: #b8860b;
  color: #fff;
  font-weight: 700;
  font-size: 36rpx;
  border-radius: 999rpx;
  padding: 24rpx 64rpx;
  box-shadow: 0 8rpx 20rpx rgba(184, 134, 11, 0.45);
  opacity: 0;
  animation: titlePop 0.5s cubic-bezier(0.22, 1.4, 0.36, 1) 1.2s forwards;
}
