/* ==================== 中秋抽奖规则卡片 ==================== */
.rule-card {
  margin-top: 30rpx;
  width: 690rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(184, 134, 11, 0.35);
  border-radius: 20rpx;
  padding: 24rpx 26rpx 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(74, 43, 107, 0.10);
}
.rule-head {
  text-align: center;
  color: #b8860b;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 18rpx;
}
/* 「单笔消费」文字正下方的红色直线提示 */
.rule-head-em {
  display: inline-block;
  padding-bottom: 6rpx;
  border-bottom: 4rpx solid #ed1c24;
  line-height: 1;
}
.rule-tiers {
  display: flex;
  justify-content: space-between;
}
.rule-tier {
  flex: 1;
  text-align: center;
  background: rgba(184, 134, 11, 0.08);
  border-radius: 14rpx;
  padding: 14rpx 0 16rpx;
  margin: 0 8rpx;
}
.rule-tier-amt {
  color: #4a2b6b;
  font-size: 26rpx;
  font-weight: 600;
}
.rule-tier-times {
  margin-top: 6rpx;
  color: #ed1c24;
  font-size: 32rpx;
  font-weight: 800;
}
.rule-foot {
  margin-top: 16rpx;
  text-align: center;
  color: #9b8bab;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
