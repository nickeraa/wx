<!--全屏背景层：image组件fixed覆盖整个视口，含手机底部安全区-->
<image class="bg-layer" src="{{bg}}" mode="scaleToFill"></image>
<!--状态栏区域-->
<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg  bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <view class="head-title canui-head-title"></view>
    </view>
</view>
<view class="container" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:calc(100vh - 160rpx);">

  <view class='frame_view'>
<view class='frame_row'>
<view class='frame_item' style='opacity:{{color[0]}}'>
  <image class='frame_img' src='{{images[0]}}'></image>
</view>
<view class='frame_item' style='opacity:{{color[1]}}'>
  <image class='frame_img' src='{{images[1]}}'></image>
</view>
<view class='frame_item' style='opacity:{{color[2]}}'>
  <image class='frame_img' src='{{images[2]}}'></image>
</view>
</view>

<view class='frame_row'>
<view class='frame_item' style='opacity:{{color[7]}}'>
  <image class='frame_img' src='{{images[7]}}'></image>
</view>
<view class='frame_item luck_btn {{clickLuck?"":"luck_disabled"}}' bindtap='{{clickLuck}}'>
  <image class='frame_img' src='{{btnconfirm}}'></image>
</view>
<view class='frame_item' style='opacity:{{color[3]}}'>
  <image class='frame_img' src='{{images[3]}}'></image>
</view>
</view>

<view class='frame_row'>
<view class='frame_item' style='opacity:{{color[6]}}'>
  <image class='frame_img' src='{{images[6]}}'></image>
</view>
<view class='frame_item' style='opacity:{{color[5]}}'>
  <image class='frame_img' src='{{images[5]}}'></image>
</view>
<view class='frame_item' style='opacity:{{color[4]}}'>
  <image class='frame_img' src='{{images[4]}}'></image>
</view>
</view>
</view>
<!--中秋抽奖规则卡片：三档金额并列 + 底部补充说明-->
<view class="rule-card">
  <view class="rule-head">中秋抽奖规则 · <text class="rule-head-em">单笔消费</text></view>
  <view class="rule-tiers">
    <view class="rule-tier">
      <view class="rule-tier-amt">满1000元</view>
      <view class="rule-tier-times">抽1次</view>
    </view>
    <view class="rule-tier">
      <view class="rule-tier-amt">满2000元</view>
      <view class="rule-tier-times">抽2次</view>
    </view>
    <view class="rule-tier">
      <view class="rule-tier-amt">满3000元</view>
      <view class="rule-tier-times">抽3次</view>
    </view>
  </view>
  <view class="rule-foot">9月25日-9月30日 · 每位顾客最多抽3次</view>
</view>
</view>

<!--核验抽奖资格加载弹窗：点击抽奖预检期间显示-->
<view class="cu-modal {{showChecking?'show':''}}" style="z-index:99998;">
  <view class="cu-dialog notice-dialog" catchtap="">
    <view class="notice-title title icon-title text-orange">正在核验抽奖资格</view>
    <view class="notice-loading"></view>
  </view>
</view>

<!--通用美化提示弹窗：替代系统showModal，样式与领奖方式卡片统一（z-index最高，不被其他弹窗遮挡）-->
<view class="cu-modal {{showTip?'show':''}}" style="z-index:99999;">
  <view class="cu-dialog notice-dialog" catchtap="">
    <view class="notice-title">{{tipTitle}}</view>
    <view class="notice-body">
      <view>{{tipContent}}</view>
    </view>
    <view class="notice-btn" bindtap="closeTip">确定</view>
  </view>
</view>

<!--会员卡号输入弹窗：点击抽奖先输入卡号，确认后开始抽奖-->
<view class="cu-modal {{showCardInput?'show':''}}">
  <view class="cu-dialog" catchtap="">
    <view class="cu-bar bg-white justify-end">
      <view class="content title icon-title text-orange" style="background:linear-gradient(180deg,#e9c15c 0%,#b8860b 45%,#6b4e03 100%);-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:700;font-size:36rpx;letter-spacing:4rpx;">广天会员专享</view>
      <view class="action" bindtap="closeCardInput">
        <text class="icon-close text-red"></text>
      </view>
    </view>
    <view class="padding-xl">
      <input type="text" value="{{member_card}}" bindinput="onCardInput" placeholder="请输入会员卡号" style="border:1rpx solid #ddd;border-radius:12rpx;padding:0 24rpx;height:88rpx;line-height:88rpx;font-size:32rpx;text-align:left;box-sizing:border-box;" />
      <view wx:if="{{remainChances > 0}}" style="margin-top:20rpx;text-align:center;color:#b8860b;font-size:28rpx;">您还有<text style="font-weight:700;font-size:36rpx;">{{remainChances}}</text>次抽奖机会</view>
    </view>
    <view class="cu-bar bg-white justify-end">
      <view class="action">
        <button class="cu-btn round" bindtap="closeCardInput" style="background:#fff;color:#b8860b;border:2rpx solid #b8860b;">取消</button>
        <button class="cu-btn margin-left round" bindtap="confirmCard" style="background:#b8860b;color:#fff;font-weight:700;">确认抽奖</button>
      </view>
    </view>
  </view>
</view>

<!--中奖飞入动画层：奖品从顶部飞入屏幕中央，烟花粒子+旋转光芒+脉冲光环+彩带-->
<!-- 中奖画面不可关闭：去掉遮罩点击关闭和右上角X，客户只能通过退出小程序离开 -->
<view wx:if="{{showFly}}" class="fly-mask">
  <view class="fly-spot spot-left"></view>
  <view class="fly-spot spot-right"></view>
  <view class="fly-glow-floor"></view>
  <view class="fly-rays"></view>
  <view class="fly-pulse"></view>
  <view class="spark" wx:for="{{sparks}}" wx:key="index" style="--x:{{item.x}};--y:{{item.y}};--c:{{item.c}};--d:{{item.d}};"></view>
  <view class="confetti" wx:for="{{confettis}}" wx:key="index" style="left:{{item.l}};width:{{item.w}};height:{{item.h}};--c:{{item.c}};--d:{{item.d}};"></view>
  <view class="fly-prize-box">
    <view class="fly-title">恭喜您中奖！</view>
    <view class="fly-img-wrap">
      <image class="fly-prize" src="{{flyImg}}" mode="aspectFit"></image>
    </view>
    <view class="fly-follow" catchtap="openOfficial"><text class="icon-right" style="color:#2ee56c;font-size:36rpx;"></text><text class="icon-right" style="color:#2ee56c;font-size:36rpx;margin-left:-12rpx;"></text><text class="icon-right" style="color:#2ee56c;font-size:36rpx;margin-left:-12rpx;margin-right:8rpx;"></text>点击关注公众号，获取兑奖方式</view>
  </view>
</view>

<!--温馨提醒弹窗：领奖方式提示（点击关注公众号后展示，返回可见）-->
<view class="cu-modal {{showNotice?'show':''}}">
  <view class="cu-dialog notice-dialog" catchtap="">
    <view class="notice-close" bindtap="closeNotice"><text class="icon-close"></text></view>
    <view class="notice-title title icon-title text-orange">{{noticeReady ? '领奖方式' : '正在加载'}}</view>
    <view class="notice-body" wx:if="{{noticeReady}}">
      <view>亲，请与您的<text class="notice-hl">专属顾问</text>联系</view>
      <view>领取奖品，谢谢！</view>
    </view>
    <view class="notice-loading" wx:else></view>
    <view class="notice-btn" bindtap="closeNotice">我知道了</view>
  </view>
</view>



